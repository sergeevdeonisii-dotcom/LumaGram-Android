    public static void main(String[] args){
        Context context=new Context();MessageObject post=new MessageObject();
        for(float density:new float[]{1f,1.2f,1.33f,1.51f,1.75f,2f,2.625f,3.5f,4f})for(float fontScale:new float[]{1f,1.3f,2f})for(int widthDp:new int[]{160,240,280,320,360,440,640,800})for(int count:new int[]{1,3,6,20,100,1000}){
            AndroidUtilities.density=density;AndroidUtilities.fontScale=fontScale;int width=AndroidUtilities.dp(widthDp);
            LunagramFeedActivity screen=new LunagramFeedActivity();ArrayList<TLRPC.Reaction> choices=new ArrayList<>();for(int i=0;i<count;i++)choices.add(plain("♥"));
            LunagramFeedActivity.ReactionGrid grid=screen.new ReactionGrid(context,post,choices);
            grid.onMeasure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(0,View.MeasureSpec.UNSPECIFIED));
            int slot=AndroidUtilities.dp(48)+AndroidUtilities.dp(8);
            int columns=Math.max(1,Math.min(8,(width-2*AndroidUtilities.dp(16))/slot));
            check(grid.manager.getSpanCount()==columns,"columns adapt to actual dialog width");
            check((width-2*AndroidUtilities.dp(16))/columns>=slot,"slot keeps48dp target plus8dp gap even with fractional-density ceil");
            check(grid.height==Math.min(AndroidUtilities.dp(280),((count+columns-1)/columns)*slot+2*AndroidUtilities.dp(8)),"content-driven height, bounded many-choice scroll");
            if(count==3&&widthDp>=240)check(grid.height==slot+2*AndroidUtilities.dp(8),"three choices stay one compact row");
            RecyclerView.ViewHolder targetHolder=grid.adapter.onCreateViewHolder(grid,0);
            LunagramFeedActivity.ReactionOption targetOption=(LunagramFeedActivity.ReactionOption)targetHolder.itemView;
            LayoutHelper.FrameParams targetParams=(LayoutHelper.FrameParams)targetOption.target.params;
            RecyclerView.LayoutParams outerParams=(RecyclerView.LayoutParams)targetOption.params;
            check(targetParams.width==AndroidUtilities.dp(48)&&targetParams.height==AndroidUtilities.dp(48),"explicit48x48dp native target, never margin-subtracted undersize");
            check(targetParams.gravity==Gravity.CENTER&&outerParams.height>=targetParams.height+AndroidUtilities.dp(8),"centered target has bounded clear spacing");
            check(targetOption.emoji.textSizePx==28*density&&targetOption.emoji.textSizePx<targetParams.height,"emoji is28dp pictogram, not56dp sp glyph clipped at200percent font");
            grid.onMeasure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(AndroidUtilities.dp(100),View.MeasureSpec.AT_MOST));
            check(grid.height<=AndroidUtilities.dp(100),"small/landscape height constrained by dialog");
            int resized=AndroidUtilities.dp(320);grid.onMeasure(View.MeasureSpec.makeMeasureSpec(resized,View.MeasureSpec.EXACTLY),0);
            check(grid.manager.getSpanCount()==(resized-2*AndroidUtilities.dp(16))/slot,"same object adapts after resize");
        }
        AndroidUtilities.density=1;AndroidUtilities.fontScale=1;
        LunagramFeedActivity screen=new LunagramFeedActivity();TLRPC.Reaction first=plain("🔥"),second=custom(9001),third=plain("👍");
        screen.chooseReaction(post);screen.chooseReaction(post);check(screen.feed.loads==1,"pending load deduped");
        screen.feed.pending.accept(allowed(first,second,third,new TLRPC.TL_reactionPaid()));
        LunagramFeedActivity.ReactionGrid grid=(LunagramFeedActivity.ReactionGrid)screen.lastDialog.customView;
        check(grid.adapter.getItemCount()==3,"only server-allowed free emoji choices, no fabricated/paid entries");
        RecyclerView.ViewHolder holder=grid.adapter.onCreateViewHolder(grid,0);grid.adapter.onBindViewHolder(holder,1);
        LunagramFeedActivity.ReactionOption option=(LunagramFeedActivity.ReactionOption)holder.itemView;grid.holders.add(option);
        AnimatedEmojiDrawable drawable=option.custom.animatedEmojiDrawable;
        check(drawable.account==2&&drawable.id==9001,"custom emoji uses fragment account and exact server document");
        check(option.custom.visibility==View.VISIBLE&&option.emoji.visibility==View.GONE,"custom emoji has real image renderer, not undrawn text span");
        option.custom.onAttachedToWindow();check(drawable.callbacks==1,"native attach registers renderer callback");
        option.custom.onDraw(new Canvas());check(drawable.receiver.draws==1,"actual native renderer paints custom receiver");
        option.custom.onDetachedFromWindow();check(drawable.callbacks==0,"native detach releases renderer callback");
        option.custom.onAttachedToWindow();grid.adapter.onBindViewHolder(holder,0);
        check(drawable.callbacks==0&&option.custom.animatedEmojiDrawable==null,"custom-to-plain recycling releases old drawable");
        check(option.emoji.visibility==View.VISIBLE&&option.custom.visibility==View.GONE&&"🔥".contentEquals(option.emoji.text),"plain emoji rebound correctly");
        grid.adapter.onBindViewHolder(holder,1);drawable=option.custom.animatedEmojiDrawable;
        check(drawable.callbacks==1,"attached rebind registers new renderer once");
        grid.adapter.onViewRecycled(holder);check(drawable.callbacks==0,"view recycling releases renderer");
        grid.adapter.onBindViewHolder(holder,0);option.target.click();
        check(screen.feed.sends==1&&screen.feed.sent==first&&!screen.reactionDialog.shown,"one click sends exact allowed reaction through existing feed guard and dismisses");
        screen.react(post,new TLRPC.TL_reactionPaid());check(screen.opens==1&&screen.feed.sends==1,"paid entry never spends from feed");
        screen.visible=false;option.target.click();check(screen.feed.sends==1,"paused click cannot send");
        screen.visible=true;screen.config.owner=43;option.target.click();check(screen.feed.sends==1,"owner change cannot send stale picker choice");
        for(int mode=0;mode<4;mode++){
            LunagramFeedActivity stale=new LunagramFeedActivity();stale.chooseReaction(post);
            if(mode==0)stale.visible=false;if(mode==1)stale.config.owner++;if(mode==2)stale.activity=false;
            stale.feed.pending.accept(mode==3?null:allowed(first));
            check(stale.lastDialog==null,"late callback after pause/owner/activity loss or error cannot open picker");
        }
        LunagramFeedActivity disabled=new LunagramFeedActivity();disabled.chooseReaction(post);disabled.feed.pending.accept(allowed());
        check(disabled.lastDialog.customView==null&&disabled.feed.sends==0,"empty server choices retain disabled message");
        MediaDataController.instance.reactions.clear();MediaDataController.instance.reactions.add(new TLRPC.TL_availableReaction("♥",false,false));
        MediaDataController.instance.reactions.add(new TLRPC.TL_availableReaction("inactive",true,false));MediaDataController.instance.reactions.add(new TLRPC.TL_availableReaction("premium",false,true));
        for(boolean premium:new boolean[]{false,true}){
            LunagramFeedActivity all=new LunagramFeedActivity();all.config.premium=premium;all.chooseReaction(post);TLRPC.ChatFull full=new TLRPC.ChatFull();full.available_reactions=new TLRPC.TL_chatReactionsAll();all.feed.pending.accept(full);
            check(((LunagramFeedActivity.ReactionGrid)all.lastDialog.customView).adapter.getItemCount()==(premium?2:1),"all-mode preserves inactive/premium entitlement filter");
        }
        LunagramFeedActivity paused=new LunagramFeedActivity();paused.chooseReaction(post);paused.feed.pending.accept(allowed(second));
        grid=(LunagramFeedActivity.ReactionGrid)paused.lastDialog.customView;holder=grid.adapter.onCreateViewHolder(grid,0);grid.adapter.onBindViewHolder(holder,0);option=(LunagramFeedActivity.ReactionOption)holder.itemView;grid.holders.add(option);
        option.custom.onAttachedToWindow();drawable=option.custom.animatedEmojiDrawable;paused.onPause();
        check(!paused.visible&&!paused.reactionDialog.shown&&drawable.callbacks==0,"pause closes picker and releases attached custom emoji");
        paused.onFragmentDestroy();check(paused.feed.closes==1,"destroy preserves feed cancellation");
        System.out.println("PASS actual feed reaction picker/native emoji lifecycle: "+checks+" modeled host checks");
    }
