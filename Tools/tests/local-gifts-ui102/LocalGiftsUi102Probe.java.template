    // PRODUCTION_SHARED_SELF_HELPER
    public static void main(String[] args) {
        UserConfig.identity = 1001;
        Parent p = new Parent(); Page page = new Page(p);
        LumaLocalGifts.LocalSavedGift l1 = new LumaLocalGifts.LocalSavedGift(1001, 11);
        LumaLocalGifts.LocalSavedGift l2 = new LumaLocalGifts.LocalSavedGift(1001, 12);
        LumaLocalGifts.entries.add(l1); LumaLocalGifts.entries.add(l2); p.reloadLocalGifts();
        check(p.localProfileGifts.size() == 2 && p.localDisplayGifts(p.list).size() == 2, "Own main tab includes local entries");
        check(p.localDisplayGifts(new StarsController.GiftsList()).isEmpty(), "Collection tabs exclude local entries");
        p.dialogId = 2002;
        check(p.localDisplayGifts(p.list).isEmpty(), "Other user profile excludes local entries");
        p.reloadLocalGifts(); check(p.localProfileGifts.isEmpty(), "Other user reload does not copy own local data");
        p.dialogId = -2002;
        check(p.localDisplayGifts(p.list).isEmpty(), "Channel profile excludes local entries");
        p.dialogId = 1001; p.reloadLocalGifts();
        LumaAccountData.writes = 0;
        p.setGiftPinnedLocally(new LumaLocalGifts.LocalSavedGift(9002, 99), true);
        check(p.localPinnedGiftIds.isEmpty() && LumaAccountData.writes == 0, "Foreign-owner local marker cannot be pinned even in the right current slot");
        ProfileActivity profile = new ProfileActivity();
        check(profile.hasLocalGiftsForProfile() && hasLocalGiftsForDialog(0, 1001), "Self-only helpers include available local collection");
        LumaLocalGifts.availabilityCalls = 0;
        profile.dialogId = 2002;
        check(!profile.hasLocalGiftsForProfile() && !hasLocalGiftsForDialog(0, 2002) && !hasLocalGiftsForDialog(0, -1001), "Self-only tab helpers exclude other users and channels");
        check(LumaLocalGifts.availabilityCalls == 0, "Other-profile tab calculation cannot read own private local store");
        p.setGiftPinnedLocally(l2, true);
        ArrayList<UItem> ui = display(page);
        ArrayList<Object> tiles = new ArrayList<>();
        for (UItem item : ui) if (item.object instanceof TL_stars.SavedStarGift) tiles.add(item.object);
        check(tiles.equals(Arrays.asList(l2, l1)), "Local pinned pass preserves stable display order");
        check(page.listView.getSpanCount() == 2, "Two local-only gifts negotiate two columns");
        for (UItem item : ui) if (item.kind.endsWith("header") || item.kind.equals("toggle")) check(item.spanCount == 2, "Header/action spans the entire local-only grid");
        check(p.list.gifts.isEmpty() && p.list.totalCount == 0, "Local UI never mutates real server inventory");
        check(p.getGiftsCount() == 2, "Local-only gifts count remains visible in own profile");
        check(!p.hasMissingLocalPins(p.list), "A missing local gift pin never asks the server for more inventory pages");
        p.localPinnedGiftIds.add("saved:9999");
        check(p.hasMissingLocalPins(p.list), "Missing real server pin still participates in real inventory loading");
        p.localPinnedGiftIds.remove("saved:9999");
        p.localProfileGifts.clear(); p.localProfileGifts.add(l1); p.list.loading = true;
        ui = display(page);
        int placeholders = 0;
        for (UItem item : ui) { if (item.kind.equals("flicker")) placeholders++; if (item.kind.endsWith("header")) check(item.spanCount == 1, "Single local header spans one-column grid"); }
        check(page.listView.getSpanCount() == 1 && placeholders == 1, "Loading placeholder respects real one-column grid, not a hardcoded three");
        p.list.loading = false; p.reloadLocalGifts();
        TL_stars.SavedStarGift a = server(100), b = server(200), c = server(300);
        p.list.gifts.add(a); p.list.gifts.add(b); p.list.totalCount = 2; page.reordering = true;
        ui = display(page);
        check(page.listView.getSpanCount() == 3, "Mixed normal/local gifts keep three grid columns");
        for (UItem item : ui) if (item.kind.endsWith("header")) check(item.spanCount == 3, "Both section headers are full-width in mixed grid");
        check(!page.canReorder(l1) && page.canReorder(a), "Local marker is never server-reorderable");
        StarsController.GiftsList originalList = page.list;
        page.list = new StarsController.GiftsList(); page.isCollection = true;
        check(!page.canReorder(null), "Collection header/spacer without a gift never gains drag movement flags");
        page.list = originalList; page.isCollection = false;
        int aPosition = -1, bPosition = -1;
        for (int i = 0; i < ui.size(); i++) { if (ui.get(i).object == a) aPosition = i; if (ui.get(i).object == b) bPosition = i; }
        check(aPosition > 0 && bPosition > aPosition, "UI holders carry header/local gift offset");
        check(page.onMove(new RecyclerView(), new RecyclerView.ViewHolder(b, bPosition), new RecyclerView.ViewHolder(a, aPosition)), "Allowed raw gifts reorder despite UI offset");
        check(p.list.gifts.equals(Arrays.asList(b, a)), "Raw identity mapping reorders intended real gift, not header index");
        check(page.listView.adapter.from == bPosition && page.listView.adapter.to == aPosition, "Adapter notification keeps the corresponding visual positions");
        p.list.gifts.clear(); p.list.gifts.add(a); p.list.gifts.add(b); p.list.gifts.add(c); p.list.totalCount = 3;
        p.list.reorder(0, 2);
        check(p.list.gifts.equals(Arrays.asList(b, c, a)), "Actual server-list reorder can insert the dragged first gift at the end");
        p.list.gifts.clear(); p.list.gifts.add(a); p.list.reorder(0, 0);
        check(p.list.gifts.equals(Collections.singletonList(a)), "Actual single-element reorder never drops the only gift");
        p.list.gifts.clear(); p.list.gifts.add(a); p.list.gifts.add(b); p.list.gifts.add(c);
        p.setGiftPinnedLocally(a, true);
        check(!page.onMove(new RecyclerView(), new RecyclerView.ViewHolder(c, 8), new RecyclerView.ViewHolder(a, 6)),
                "Drag across local-pin display groups must not contradict notifyItemMoved");
        check(!page.onMove(new RecyclerView(), new RecyclerView.ViewHolder(b, -1), new RecyclerView.ViewHolder(c, 8)),
                "Detached holder NO_POSITION cannot reach notifyItemMoved");
        p.localPinnedGiftIds.clear(); LumaAccountData.writes = 0;
        UserConfig.identity = 9002;
        p.setGiftPinnedLocally(l1, true);
        check(p.localPinnedGiftIds.isEmpty() && LumaAccountData.writes == 0, "Stale local pin callback cannot write into a reused account slot");
        check(p.localDisplayGifts(p.list).isEmpty(), "Account reuse immediately hides cached previous-owner tiles");
        UserConfig.identity = 0; LumaLocalGifts.availabilityCalls = 0;
        profile.dialogId = 0;
        check(!profile.hasLocalGiftsForProfile() && !hasLocalGiftsForDialog(0, 0) && LumaLocalGifts.availabilityCalls == 0,
                "Logged-out zero identity does not query private collection");
        UserConfig.identity = 1001;
        Utilities.globalQueue.automatic = false; AndroidUtilities.ui.automatic = false;
        p.reloadLocalGifts(); Utilities.globalQueue.drain();
        LumaLocalGifts.entries.clear(); LumaLocalGifts.entries.add(l2);
        p.reloadLocalGifts(); Utilities.globalQueue.drain(); AndroidUtilities.ui.drain();
        check(p.localProfileGifts.equals(Collections.singletonList(l2)), "Newest asynchronous reload wins over stale queued UI apply");
        LumaLocalGifts.entries.clear(); LumaLocalGifts.entries.add(l1);
        p.reloadLocalGifts(); Utilities.globalQueue.drain(); UserConfig.identity = 9002; AndroidUtilities.ui.drain();
        check(p.localProfileGifts.equals(Collections.singletonList(l2)), "Account switch after worker snapshot discards prior-owner UI apply");
        UserConfig.identity = 1001;
        p.reloadLocalGifts(); Utilities.globalQueue.drain(); p.localGiftsLoadGeneration++; AndroidUtilities.ui.drain();
        check(p.localProfileGifts.equals(Collections.singletonList(l2)), "Detach generation invalidates an outstanding UI apply");
        System.out.println("PASS: " + checks + " production-derived local gift grid/self/reorder/stale-owner UI checks (JVM edges, not rendered device UI).");
    }
