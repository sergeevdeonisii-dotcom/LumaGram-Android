        LunagramMediaAccess.Session lunagramPreviewSession=LunagramMediaAccess.forAccount(0);
        boolean worker(){return !(@@WORKER@@);}
        boolean dispatch(){return !(@@DISPATCH@@);}
        boolean callback(){return !(@@CALLBACK@@);}
    }
    static class Links {
        Host host=new Host();int account;LunagramMediaAccess.Session session=LunagramMediaAccess.forAccount(0);BooleanSupplier contextValid=()->true;
        @@LINK_VALID@@
    }
