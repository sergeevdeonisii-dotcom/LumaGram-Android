        }
        AccessTest.reset();Preview p=new Preview();LunagramLinkSettings.setPreviewDisabled(0,55,true);p.editingMessageObject=new Object();check(!p.worker()&&!p.dispatch()&&!p.callback(),"Per-chat privacy also blocks edit preview");LunagramLinkSettings.setPreviewDisabled(0,55,false);check(p.worker()&&p.dispatch()&&p.callback(),"Explicit preview re-enable permits editing");SharedConfig.appLocked=true;check(!p.dispatch(),"Lock also blocks edit preview");
