        s.close();check(s.closed&&s.engine==null&&s.dialog==null&&s.chunks.isEmpty(),"Speech clears retained resources");check(engine.stops==1&&engine.shutdowns==1&&!dialog.showing,"Speech releases engine and dialog");s.close();check(engine.stops==1&&engine.shutdowns==1,"Speech close is idempotent under dismiss recursion");
        s=new Speech();engine=s.engine;engine.throwStop=true;s.close();check(engine.shutdowns==1,"Speech shutdown still runs if stop throws");
