        LunagramSubscriptionAccess.allowed=true;LumaLocalGifts.removes=0;
        UserConfig.selectedAccount=0;UserConfig.user=42;
        Utilities.globalQueue.tasks.clear();AndroidUtilities.ui.tasks.clear();
