        check(p.localProfileGifts.size()==1,"expiry preserves local data");
        sheet.setLocalPreview(p.fragment,gift);check(sheet.localPreviewGift==null,"direct local bind denied after expiry");
        LunagramSubscriptionAccess.allowed=true;check(owner.size()==2,"reactivation restores local overlay from retained data");
