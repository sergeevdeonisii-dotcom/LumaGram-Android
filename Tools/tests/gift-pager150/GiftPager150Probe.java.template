        unique.availability_issued=9;unique.availability_total=100;unique.flags=256;unique.value_amount=1500;unique.value_currency="USD";
        LumaLocalGiftPreview.addStoredMetadataRows(table,unique);check(table.rows.size()==2,"real stored quantity and value");
        for(String currency:new String[]{null,"USD<script>","XYZ"}){table.clear();unique.value_currency=currency;LumaLocalGiftPreview.addStoredMetadataRows(table,unique);check(table.rows.size()==1,"invalid currency omitted");}
