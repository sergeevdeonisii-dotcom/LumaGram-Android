            Parent p=new Parent();TL_stars.SavedStarGift a=real(1,false),b=real(2,true);LumaLocalGifts.LocalSavedGift clone=local(2),c=local(3);
            p.list.gifts.add(a);p.list.gifts.add(b);p.localProfileGifts.add(clone);p.localProfileGifts.add(c);
            TL_stars.SavedStarGift[] all={a,b,clone,c};for(int i=0;i<4;i++)if((pins&(1<<i))!=0)p.localPinnedGiftIds.add(p.getLocalGiftId(all[i]));
            LumaLocalGiftPreview.PagerSource source=p.createPreviewPager(p.list);
            check(source!=null,"mixed pager available in both editions");
            StarGiftSheet s=new StarGiftSheet();s.setProfilePreviewPager(source);
            check(source.size()==4,"combined count");check(source.indexOf(b)!=source.indexOf(clone),"real unique and local clone stay distinct");
            check(!s.eq(b,clone),"native neighbor equality separates local clone from server gift");
            for(int index=0;index<4;index++){
                TL_stars.SavedStarGift item=source.get(index);s.bindProfilePreview(item);
                if(item instanceof LumaLocalGifts.LocalSavedGift)check(s.localPreviewGift==item,"native local binder available in both editions");
                check(s.getProfilePreviewPosition()==index,"display position");
                check(s.getNeighbourSavedGift(false)==(index==0?null:source.get(index-1)),"left neighbor matches displayed order");
                check(s.getNeighbourSavedGift(true)==(index==3?null:source.get(index+1)),"right neighbor matches displayed order");
                if(item instanceof LumaLocalGifts.LocalSavedGift){
                    check(s.savedStarGift==null&&s.slugStarGift==null&&s.messageObject==null&&s.slug==null,"transaction identities cleared");
                    check(s.getInputStarGift()==null&&StarGiftSheet.getInputStarGift(42,item)==null,"private/static input conversion fails closed");
                    check(s.getGift()==null&&s.getListPosition()==-1,"local does not become server gift or upgrade index");
                    check(s.beforeTableTextView.visibility==View.GONE&&s.afterTableTextView.visibility==View.GONE&&s.underButtonContainer.visibility==View.GONE,"no transaction footer links");
                    check(Objects.equals(s.button.text,getString(R.string.OK)),"main local button is OK, never direct delete");
                    int dismissed=s.dismissed,removed=LumaLocalGifts.removes;
                    s.button.click.onClick(s.button);
                    check(s.dismissed==dismissed+1&&LumaLocalGifts.removes==removed,"main local button only dismisses");
                    s.dismissed=dismissed;
                }else{
                    check(s.topView==s.nativeTopView&&s.localPreviewGift==null,"local to real restores native header");
                    check(s.getListPosition()==p.list.gifts.indexOf(item),"upgrade lookup remains SERVER index");
                    s.overrideNextIndex=1;int translated=source.indexOf(b);int expected=translated>index?translated:index+1;
                    check(s.getProfilePreviewNeighbourIndex(true)==expected,"explicit server jump translated to UI order");s.overrideNextIndex=-1;
                }
            }
            s.bindProfilePreview(a);int requestGeneration=s.profilePreviewGeneration;
            s.nativeTopView.imageLayout.alpha=0;s.nativeTopView.imagesRollView.alpha=1;
            s.sample_attributes=new Object();s.upgrade_form=new Object();s.requesting_upgrade_form=true;
            s.button.loading=true;
            int unchanged=p.list.gifts.size();s.bindProfilePreview(clone);
            check(s.nativeTopView.imageLayout.alpha==1&&s.nativeTopView.imagesRollView.alpha==0,"roll artwork normalized before real rebind");
            check(s.sample_attributes==null&&s.upgrade_form==null&&!s.requesting_upgrade_form,"upgrade cache cleared at local boundary");
            check(!s.button.loading,"local OK does not inherit server spinner");
            s.bindProfilePreview(a);
            check(!s.isProfilePreviewRequestCurrent(requestGeneration,a),"A request after local back to A rejected");
            s.bindProfilePreview(b);
            check(!s.isProfilePreviewRequestCurrent(requestGeneration,a),"A request after local to B rebind rejected");
            check(s.isProfilePreviewRequestCurrent(s.profilePreviewGeneration,b),"current B request allowed");
            s.bindProfilePreview(clone);p.localProfileGifts.remove(clone);s.refreshProfilePreviewPager();
            check(s.localPreviewGift!=clone&&s.getProfilePreviewPosition()>=0,"removed current selects deterministic survivor");
            check(p.list.gifts.size()==unchanged,"local removal never changes real inventory");
            p.localPreviewEpoch++;s.refreshProfilePreviewPager();check(s.dismissed==1&&s.container.visibility==View.GONE,"epoch invalidation closes owner view");
            check(!source.isCurrent()&&source.size()==0,"same user ID cannot revive stale epoch");
