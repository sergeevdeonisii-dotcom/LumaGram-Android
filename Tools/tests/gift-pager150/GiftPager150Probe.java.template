        gift.ownerUserId=42;UserConfig.selectedAccount=1;foreign.setLocalPreview(p.fragment,gift);
        check(foreign.localPreviewGift==null,"inactive account cannot bind in either edition");
        UserConfig.selectedAccount=0;
