        p=new Parent();p.list.gifts.add(real(10,false));gift=local(11);p.localProfileGifts.add(gift);owner=p.createPreviewPager(p.list);
        StarGiftSheet sheet=new StarGiftSheet();sheet.setProfilePreviewPager(owner);sheet.bindProfilePreview(gift);
