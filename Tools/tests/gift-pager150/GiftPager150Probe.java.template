        owner=p.createPreviewPager(p.list);LumaLocalGiftPreview.confirmRemove(p.fragment,gift,owner::isCurrent);AlertDialog.positive.onClick(null,0);
        Utilities.globalQueue.drain();AndroidUtilities.ui.drain();check(LumaLocalGifts.removes==1,"explicit current-owner local delete works");
