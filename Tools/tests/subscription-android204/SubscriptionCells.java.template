final class AndroidUtilities {
    static float density = 1;
    static int dp(float value) { return (int) Math.ceil(density * value); }
    static Typeface bold() { return Typeface.create("sans-serif", Typeface.BOLD); }
}
final class LocaleController { static boolean isRTL; }
final class LayoutHelper {
    static final int MATCH_PARENT = -1, WRAP_CONTENT = -2;
    static FrameLayout.LayoutParams createFrame(int width, float height, int gravity,
            float left, float top, float right, float bottom) {
        FrameLayout.LayoutParams value = new FrameLayout.LayoutParams(width < 0 ? width : AndroidUtilities.dp(width),
                height < 0 ? (int) height : AndroidUtilities.dp(height), gravity);
        value.setMargins(AndroidUtilities.dp(left), AndroidUtilities.dp(top), AndroidUtilities.dp(right), AndroidUtilities.dp(bottom));
        return value;
    }
}
final class Theme {
    interface Colorable { void updateColors(); }
    interface ResourcesProvider { }
    static final int key_windowBackgroundWhiteBlackText = 0, key_windowBackgroundWhiteGrayText = 1,
            key_windowBackgroundWhiteGrayIcon = 2, key_listSelector = 3, key_dialogTextBlack = 4,
            key_dialogTextGray2 = 5, key_dialogRadioBackground = 6, key_dialogRadioBackgroundChecked = 7;
    static final Paint dividerPaint = new Paint();
    static int getColor(int key, ResourcesProvider provider) {
        return key == key_listSelector ? Color.TRANSPARENT : key == key_windowBackgroundWhiteBlackText || key == key_dialogTextBlack
                ? 0xff171717 : 0xff666666;
    }
    static Drawable createRoundRectDrawable(int radius, int color) { return new ColorDrawable(color); }
    static Drawable createSelectorDrawable(int color, int style) { return new ColorDrawable(color); }
}
final class RadioButton extends View {
    private boolean checked;
    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    RadioButton(Context context) { super(context); }
    void setSize(int size) { }
    void setColor(int unchecked, int checked) { }
    void setChecked(boolean value, boolean animated) { checked = value; }
    boolean isChecked() { return checked; }
    @Override protected void onDraw(Canvas canvas) {
        paint.setColor(0xff9988ff);
        paint.setStyle(Paint.Style.STROKE);
        paint.setStrokeWidth(AndroidUtilities.dp(2));
        canvas.drawCircle(getWidth() / 2f, getHeight() / 2f, AndroidUtilities.dp(9), paint);
        if (checked) {
            paint.setStyle(Paint.Style.FILL);
            canvas.drawCircle(getWidth() / 2f, getHeight() / 2f, AndroidUtilities.dp(5), paint);
        }
    }
}
