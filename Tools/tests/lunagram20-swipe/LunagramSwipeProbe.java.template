    static boolean heldMove(LunagramSwipeGesture g,float dx,float y,float threshold,float row) {
        int previous=g.selected();
        if(!g.menuActive() && -dx>=threshold && Float.isFinite(y) && row>0 && threshold>0) {
            g.move(dx,g.originY(),threshold,row,1000);
            g.advanceHold(1000+LunagramSwipeGesture.MENU_HOLD_MS);
        }
        g.move(dx,y,threshold,row,1000+LunagramSwipeGesture.MENU_HOLD_MS);
        return previous!=g.selected();
    }
