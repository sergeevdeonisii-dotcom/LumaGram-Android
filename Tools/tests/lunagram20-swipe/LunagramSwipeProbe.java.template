    static void quickHoldChecks(){
        int permutations=0;
        for(int a=1;a<=4;a++)for(int b=1;b<=4;b++)for(int c=1;c<=4;c++)for(int d=1;d<=4;d++) {
            int[] order={a,b,c,d};if(!LunagramSwipeGesture.validOrder(order))continue;permutations++;
            for(int direction:new int[]{1,-1})for(float drift:new float[]{-500,-48,-12,0,12,48,500}) {
                LunagramSwipeGesture g=new LunagramSwipeGesture();g.begin(200,order);g.setDirection(direction);
                g.move(-60,200,50,48,1000);g.move(-100,200+drift,50,48,1080);
                check(!g.menuActive()&&g.selected()==1,"Flick always highlights Reply regardless of drift/order");
                check(g.release(false)==1&&g.release(false)==0,"Flick commits only Reply once");
                check(!g.advanceHold(9999),"Late frame cannot open released menu");
            }
            LunagramSwipeGesture g=new LunagramSwipeGesture();g.begin(200,order);g.move(-60,200,50,48,1000);
            check(!g.advanceHold(1239)&&!g.menuActive(),"Menu waits full stable hold");
            check(g.advanceHold(1240)&&g.menuActive()&&g.selected()==1,"Stationary hold opens menu on Reply even reordered");
            float anchor=g.originY();
            for(int i=0;i<4;i++){g.move(-60,anchor+i*48,50,48,1250+i);check(g.selected()==order[i],"Held menu honors custom action order");}
            g.cancel();check(g.release(false)==0,"Held cancel never commits");
        }
        check(permutations==24,"Every reordered quick/held menu tested");
        LunagramSwipeGesture g=new LunagramSwipeGesture();g.begin(100,new int[]{1,2,3,4});g.move(-60,100,50,48,1000);
        g.move(-90,130,50,48,1230);check(!g.advanceHold(1240),"Movement resets dwell rather than opening menu during slow drag");
        check(g.advanceHold(1470)&&g.selected()==1,"New stable hold anchors Reply at new finger position");
        g.move(-90,162,50,48,1480);check(g.selected()==2,"Vertical selection available after hold");
        g.move(-20,162,50,48,1490);check(!g.menuActive()&&g.release(false)==0,"Backoff cancels held action");
        g.begin(100,new int[]{2,3,4});g.move(-60,100,50,48,1000);check(g.release(false)==0,"Unavailable Reply never turns flick into Copy or Save");
        LunagramSwipeProbe p=new LunagramSwipeProbe();SystemClock.now=2000;
        p.touch(0,300,100);p.touch(2,240,100);p.touch(2,200,148);p.touch(1,200,148);
        check(p.replyCalls==1&&p.copyCalls==0&&p.forwardCalls==0,"Extracted production quick diagonal chooses Reply");
        p=new LunagramSwipeProbe();p.touch(0,300,100);p.touch(2,240,100);
        Canvas before=new Canvas();p.dispatchDraw(before);check(!before.events.contains("rect"),"No full menu during flick");
        SystemClock.now+=240;Canvas held=new Canvas();p.dispatchDraw(held);
        check(p.lunagramSwipeGesture.menuActive()&&held.events.contains("rect"),"Actual draw advances stationary hold and displays menu");
        p.touch(2,240,148);p.touch(1,240,148);check(p.copyCalls==1&&p.replyCalls==0,"Extracted held gesture selects Copy");
        p=new LunagramSwipeProbe();p.touch(0,300,100);p.touch(2,240,100);
        org.telegram.messenger.LunagramSubscriptionAccess.paid=false;
        SystemClock.now+=300;p.dispatchDraw(new Canvas());p.touch(1,240,148);
        check(p.copyCalls==0&&p.replyCalls==0&&!p.lunagramSwipeGesture.menuActive(),"Expiry during captured gesture cancels all menu actions");
        org.telegram.messenger.LunagramSubscriptionAccess.paid=true;
    }

    static void routingChecks(){
        check(LunagramSwipeGesture.shouldCapture(-20,10,12),"Clear horizontal diagonal captures before scroll");
        check(!LunagramSwipeGesture.shouldCapture(-12,9,12)&&!LunagramSwipeGesture.shouldCapture(40,0,12)&&!LunagramSwipeGesture.shouldCapture(-11,0,12),"Vertical, right and below-slop gestures do not capture");
        check(!LunagramSwipeGesture.shouldCapture(Float.NaN,0,12)&&!LunagramSwipeGesture.shouldCapture(-20,Float.POSITIVE_INFINITY,12),"Nonfinite capture rejected");
        LunagramSwipeProbe p=new LunagramSwipeProbe();p.onInterceptTouchEvent(new MotionEvent(0,300,100));
        MotionEvent diagonal=new MotionEvent(2,280,110);check(p.onInterceptTouchEvent(diagonal),"Horizontal diagonal is intercepted before RecyclerView drag");p.onTouchEvent(diagonal);
        p.onTouchEvent(new MotionEvent(2,240,110));check(p.lunagramSwipeGesture.selected()==1&&p.scrollState==0&&!p.chatLayoutManager.scroll&&p.superTouchMoves==0,"Owned gesture stops list scrolling and arms using total horizontal displacement");
        p.onTouchEvent(new MotionEvent(5|(1<<8),240,150));p.onTouchEvent(new MotionEvent(2,240,160));check(p.lunagramSwipeTouchConsumed&&p.superTouchMoves==0,"Second pointer cancels but retains stream ownership");
        p.onTouchEvent(new MotionEvent(1,240,160));check(!p.lunagramSwipeTouchConsumed&&p.replyCalls==0&&p.copyCalls==0&&p.forwardCalls==0&&p.chatLayoutManager.scroll,"Pointer cancellation releases stream without action");
        p=new LunagramSwipeProbe();p.onInterceptTouchEvent(new MotionEvent(0,300,100));check(p.onInterceptTouchEvent(new MotionEvent(2,295,120)),"Vertical intent delegates to RecyclerView");
        check(p.scrollState==1&&!p.maybeStartTrackingSlidingView&&!p.lunagramSwipeTouchConsumed&&p.chatLayoutManager.scroll,"Vertical drag cancels swipe candidate without suppressing scroll");
        p.onInterceptTouchEvent(new MotionEvent(2,200,130));check(!p.startedTrackingSlidingView,"Later diagonal movement cannot steal an active list drag");
        p=new LunagramSwipeProbe();p.onInterceptTouchEvent(new MotionEvent(0,300,100));check(p.onInterceptTouchEvent(new MotionEvent(2,220,125)),"A single large horizontal MOVE captures");
        // ViewGroup may cancel only the old child on this MOVE and deliver the following UP to us.
        p.onTouchEvent(new MotionEvent(1,220,125));check(p.replyCalls==1&&p.copyCalls==0&&p.forwardCalls==0&&p.menuHaptics==1,"Capture MOVE followed directly by UP commits only initially highlighted Reply once");
        p=new LunagramSwipeProbe();p.onInterceptTouchEvent(new MotionEvent(0,300,100));p.onInterceptTouchEvent(new MotionEvent(2,220,125));p.onTouchEvent(new MotionEvent(3,220,125));check(p.replyCalls==0&&p.forwardCalls==0,"Single large MOVE followed by CANCEL never commits");
        for(float pull:new float[]{0,20}){
            p=new LunagramSwipeProbe();p.arm();p.pullingDownOffset=pull;Canvas canvas=new Canvas();p.dispatchDraw(canvas);
            check(canvas.events.indexOf("background")<canvas.events.indexOf("children")&&canvas.events.indexOf("children")<canvas.events.indexOf("foreground")&&canvas.events.indexOf("foreground")<canvas.events.indexOf("rect"),"Menu paints above all chat foregrounds, including translated-list route");
            check(canvas.balanced(),"Overlay preserves canvas stack");
        }
    }
