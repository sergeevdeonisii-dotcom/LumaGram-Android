    static final class Failure extends RuntimeException {}
    @interface NonNull {}
    static class RectF {
        float left, top, right, bottom;
        RectF() {}
        RectF(RectF other) { set(other); }
        RectF(float l, float t, float r, float b) { set(l, t, r, b); }
        void set(float l, float t, float r, float b) { left=l;top=t;right=r;bottom=b; }
        void set(RectF r) { set(r.left,r.top,r.right,r.bottom); }
        void set(Rect r) { set(r.left,r.top,r.right,r.bottom); }
        void offset(float dx,float dy) { left+=dx;right+=dx;top+=dy;bottom+=dy; }
        boolean intersect(RectF r) {
            if (left>=r.right||right<=r.left||top>=r.bottom||bottom<=r.top) return false;
            set(Math.max(left,r.left),Math.max(top,r.top),Math.min(right,r.right),Math.min(bottom,r.bottom));
            return true;
        }
        boolean same(RectF r) { return left==r.left&&top==r.top&&right==r.right&&bottom==r.bottom; }
    }
    static final class Rect {
        int left=64,top=96,right=160,bottom=240;
        int width(){return right-left;} int height(){return bottom-top;}
    }
    static class PointF { float x,y; }
    static class Canvas {
        static final class State {
            float x,y,sx=1,sy=1; int alpha=255; RectF clip;
            State copy(){State s=new State();s.x=x;s.y=y;s.sx=sx;s.sy=sy;s.alpha=alpha;s.clip=clip==null?null:new RectF(clip);return s;}
        }
        final ArrayList<State> stack=new ArrayList<>();
        Canvas(){stack.add(new State());}
        State state(){return stack.get(stack.size()-1);}
        int save(){int before=stack.size();stack.add(state().copy());return before;}
        int saveLayerAlpha(RectF rect,int alpha){int n=save();state().alpha=alpha;return n;}
        void restore(){restoreToCount(stack.size()-1);}
        void restoreToCount(int count){if(count<1||count>stack.size())throw new IllegalStateException();while(stack.size()>count)stack.remove(stack.size()-1);}
        void translate(float dx,float dy){state().x+=state().sx*dx;state().y+=state().sy*dy;}
        void scale(float x,float y){state().sx*=x;state().sy*=y;}
        void clipRect(RectF rect){state().clip=new RectF(rect);}
        int getSaveCount(){return stack.size();}
        boolean same(State s,int count){State t=state();return stack.size()==count&&t.x==s.x&&t.y==s.y&&t.sx==s.sx&&t.sy==s.sy&&t.alpha==s.alpha&&(t.clip==null?s.clip==null:s.clip!=null&&t.clip.same(s.clip));}
    }
    static final class RecordingCanvas extends Canvas {}
    interface ViewParent {}
    static class View implements ViewParent {
        static final int VISIBLE=0,GONE=8,INVISIBLE=4;
        float x,y,alpha=1; int width=200,height=300,visibility=VISIBLE; ViewParent parent;
        int getVisibility(){return visibility;}float getAlpha(){return alpha;}ViewParent getParent(){return parent;}
    }
    static class ViewGroup extends View {
        final ArrayList<View> children=new ArrayList<>();
        int getChildCount(){return children.size();} View getChildAt(int i){return children.get(i);}
    }
    static final class SystemClock {static long uptimeMillis(){return 1;}}
    static final class ViewPositionWatcher {
        static boolean computeCoordinatesInParent(View view,ViewGroup parent,PointF p){p.x=view.x;p.y=view.y;return true;}
        static boolean computeRectInParent(View view,ViewGroup parent,RectF r){r.set(view.x,view.y,view.x+view.width,view.y+view.height);return true;}
    }
    interface IBlur3Hash {default void add(long value){}default void add(boolean value){add(value?1:0);}default void addF(float value){}default void unsupported(){}}
    interface IBlur3Capture {
        void capture(Canvas canvas,RectF position);
        default void captureCalculateHash(IBlur3Hash hash,RectF position){hash.unsupported();}
    }
    static final class Blur3HashImpl implements IBlur3Hash {
        long hash=73,visibility=-1; boolean unsupported;
        void start(){unsupported=false;} long get(){return hash;} boolean isUnsupported(){return unsupported;}
        public void add(long value){visibility=value;}
        public void unsupported(){unsupported=true;}
    }
    static class CaptureList extends ViewGroup implements IBlur3Capture {
        IBlur3Capture delegate;
        public void capture(Canvas c,RectF p){delegate.capture(c,p);}
        public void captureCalculateHash(IBlur3Hash h,RectF p){delegate.captureCalculateHash(h,p);}
    }
