        Suppressor(){rectRenderNodes.add(new SourcePart());}
        private boolean invalidateResultRenderNodes(int w,int h){resultInvalidations++;return true;}
        // PRODUCTION_SUPPRESSOR_CAPTURE
        // PRODUCTION_SUPPRESSOR_BEGIN
        // PRODUCTION_SUPPRESSOR_END
    }
    static Canvas preparedCanvas(){Canvas c=new Canvas();c.save();c.translate(4,8);c.scale(2,3);c.clipRect(new RectF(1,2,300,400));return c;}
    static void viewGroupTests() {
        ViewGroup parent=new ViewGroup(); CaptureList list=new CaptureList();list.parent=parent;list.x=12;list.y=20;
        ViewGroupPartRenderer renderer=new ViewGroupPartRenderer(list,parent,(c,v,t)->true);
        RectF p=new RectF(100,110,180,190), original=new RectF(p);
        Canvas c=preparedCanvas();Canvas.State state=c.state().copy();int count=c.getSaveCount();Failure failure=new Failure();
        list.delegate=(canvas,rect)->{check(rect.left==88&&rect.top==90,"relative list capture coordinates");canvas.save();canvas.translate(90,70);rect.offset(500,500);throw failure;};
        try{renderer.capture(c,p);throw new AssertionError("capture must propagate failure");}catch(Failure e){check(e==failure,"original capture exception propagated");}
        check(p.same(original),"VIEWGROUP_POSITION: throwing capture restores caller rectangle");
        check(c.same(state,count),"VIEWGROUP_SCOPE: throwing/leaky child restores exact caller canvas");
        list.delegate=(canvas,rect)->{canvas.save();canvas.translate(99,77);};
        renderer.capture(c,p);
        check(c.same(state,count),"VIEWGROUP_SCOPE: successful leaky child restores canvas");check(p.same(original),"successful capture restores rectangle");
        final int[] depth={0};
        list.delegate=(canvas,rect)->{if(depth[0]++==0){RectF before=new RectF(rect);renderer.capture(canvas,rect);check(rect.same(before),"reentrant same-renderer capture preserves parent rectangle");}depth[0]--;};
        renderer.capture(c,p);check(p.same(original),"reentrant outer rectangle restored");check(c.same(state,count),"reentrant outer scope restored");
        list.delegate=new IBlur3Capture(){public void capture(Canvas a,RectF b){}public void captureCalculateHash(IBlur3Hash h,RectF rect){rect.offset(90,90);throw failure;}};
        try{renderer.captureCalculateHash(new Blur3HashImpl(),p);throw new AssertionError("hash must propagate failure");}catch(Failure e){check(e==failure,"original hash exception propagated");}
        check(p.same(original),"throwing hash capture restores rectangle");
        ViewGroup plain=new ViewGroup();plain.parent=parent;plain.x=12;plain.y=20;plain.children.add(new View());plain.children.add(new View());final int[] draws={0};
        ViewGroupPartRenderer children=new ViewGroupPartRenderer(plain,parent,(canvas,child,time)->{check(canvas.state().x==28&&canvas.state().y==68,"CHILD_SCOPE: next child starts at list transform, not previous child's leaked transform");draws[0]++;canvas.save();canvas.translate(99,99);return true;});
        children.capture(c,p);check(draws[0]==2,"both intersecting children drawn");check(c.same(state,count),"fallback children outer scope restored");
    }
    static void visibilityTests(){
        ViewGroup parent=new ViewGroup();CaptureList list=new CaptureList();
        ViewGroupPartRenderer renderer=new ViewGroupPartRenderer(list,parent,(c,v,t)->true);
        Canvas c=preparedCanvas();Canvas.State state=c.state().copy();int count=c.getSaveCount();
        RectF p=new RectF(100,110,180,190),original=new RectF(p);
        ViewGroup hiddenParent=new ViewGroup();hiddenParent.parent=parent;hiddenParent.visibility=View.GONE;list.parent=hiddenParent;
        final int[] captures={0},hashes={0};list.delegate=new IBlur3Capture(){public void capture(Canvas a,RectF b){captures[0]++;}public void captureCalculateHash(IBlur3Hash h,RectF b){hashes[0]++;}};
        Blur3HashImpl visibilityHash=new Blur3HashImpl();renderer.capture(c,p);renderer.captureCalculateHash(visibilityHash,p);
        check(captures[0]==0&&hashes[0]==0&&visibilityHash.visibility==0,"HIDDEN_PAGE: GONE ancestor prevents capture/hash and records hidden state");
        hiddenParent.visibility=View.INVISIBLE;renderer.capture(c,p);check(captures[0]==0,"INVISIBLE ancestor is not captured");
        hiddenParent.visibility=View.VISIBLE;hiddenParent.alpha=0;renderer.capture(c,p);check(captures[0]==0,"fully transparent ancestor is not captured");
        hiddenParent.alpha=1;renderer.capture(c,p);renderer.captureCalculateHash(visibilityHash,p);check(captures[0]==1&&hashes[0]==1&&visibilityHash.visibility==1,"visible ancestor re-enables capture and changes visibility hash");
        list.parent=null;renderer.capture(c,p);renderer.captureCalculateHash(visibilityHash,p);check(captures[0]==1&&hashes[0]==1&&visibilityHash.visibility==0,"detached/wrong ancestor is never captured");
        check(p.same(original)&&c.same(state,count),"hidden/visible captures preserve caller state");
    }
    static void relativeTests(){
        Canvas c=preparedCanvas();Canvas.State state=c.state().copy();int count=c.getSaveCount();ViewGroup parent=new ViewGroup();View view=new View();view.x=30;view.y=40;
        RectF p=new RectF(100,110,180,190),original=new RectF(p);Failure failure=new Failure();
        IBlur3Capture bad=(canvas,rect)->{check(rect.left==70&&rect.top==70,"relative capture rectangle");canvas.save();canvas.translate(99,88);rect.offset(600,600);throw failure;};
        try{RelativeCapture.captureRelativeParent(bad,c,p,view,parent,77);throw new AssertionError("relative must propagate");}catch(Failure e){check(e==failure,"relative exception identity");}
        check(c.same(state,count),"RELATIVE_SCOPE: alpha/translation/leaked saves restored");check(p.same(original),"relative helper protects caller rectangle");
        IBlur3Capture nested=(canvas,rect)->{RectF before=new RectF(rect);View nestedView=new View();nestedView.x=5;nestedView.y=7;RelativeCapture.captureRelativeParent((cc,rr)->{rr.offset(600,700);cc.save();cc.translate(123,456);},canvas,rect,nestedView,parent,111);check(rect.same(before),"RELATIVE_RECT: nested helper must not corrupt outer capture input");};
        RelativeCapture.captureRelativeParent(nested,c,p,view,parent,128);check(c.same(state,count),"nested relative capture restored");check(p.same(original),"nested relative caller rectangle unchanged");
        View zero=new View();RelativeCapture.captureRelativeParent((canvas,rect)->{canvas.save();canvas.translate(4,7);},c,p,zero,parent,255);check(c.same(state,count),"zero-offset full-alpha capture still isolates leaky child");
        RelativeCapture.captureRelativeParent((canvas,rect)->{throw new AssertionError("transparent capture invoked");},c,p,view,parent,0);check(c.same(state,count),"transparent capture stays no-op");
    }
    static void suppressorTests(){
        Suppressor s=new Suppressor();Suppressor.SourcePart part=s.rectRenderNodes.get(0);Failure failure=new Failure();final int[] calls={0};
        IBlur3Capture bad=(canvas,rect)->{calls[0]++;canvas.save();canvas.translate(99,88);throw failure;};
        try{s.invalidateResultRenderNodes(bad,300,400);throw new AssertionError("suppressor must propagate");}catch(Failure e){check(e==failure,"suppressor exception identity");}
        check(s.recordingPos==null&&!part.renderNode.recording,"SUPPRESSOR_CLEANUP: failed capture closes recording and clears latch");
        check(!part.renderNode.hasDisplayList(),"SUPPRESSOR_CACHE: failed partial display list discarded");
        check(part.lastHash==66,"SUPPRESSOR_CACHE: failure does not publish successful hash");
        check(part.renderNode.canvas.getSaveCount()==1&&part.renderNode.canvas.state().x==0&&part.renderNode.canvas.state().y==0,"failed recording restores canvas scope");
        IBlur3Capture good=new IBlur3Capture(){public void capture(Canvas canvas,RectF rect){calls[0]++;check(canvas.state().x==-64&&canvas.state().y==-96,"capture source position preserved on retry");canvas.save();canvas.translate(77,99);}public void captureCalculateHash(IBlur3Hash h,RectF r){}};
        check(s.invalidateResultRenderNodes(good,300,400),"next capture succeeds after failure");check(part.renderNode.hasDisplayList()&&part.lastHash==73,"successful display list/hash published");
        check(s.recordingPos==null&&!part.renderNode.recording,"successful recording closes latch");check(part.renderNode.canvas.getSaveCount()==1&&part.renderNode.canvas.state().x==0&&part.renderNode.canvas.state().y==0,"successful leaky recording restored");
        check(!s.invalidateResultRenderNodes(good,300,400)&&calls[0]==2,"successful cache prevents duplicate capture");
    }
    static void hashTests(){
        RenderNode node=new RenderNode();Failure failure=new Failure();final boolean[] fail={true};final int[] calls={0};
        RenderNodeWithHash hashed=new RenderNodeWithHash(node,new RenderNodeWithHash.Renderer(){public void renderNodeUpdateDisplayList(Canvas c){calls[0]++;c.save();c.translate(77,99);if(fail[0])throw failure;}public void renderNodeCalculateHash(IBlur3Hash h){}});
        try{hashed.updateDisplayListIfNeeded();throw new AssertionError("hash renderer must propagate");}catch(Failure e){check(e==failure,"hash renderer original exception");}
        check(!node.recording&&!node.hasDisplayList(),"HASH_CLEANUP: failed hash renderer ends and discards partial recording");
        check(hashed.lastHash==0&&hashed.lastWidth==0&&hashed.lastHeight==0,"HASH_CACHE: failed rendering must not publish dimensions/hash");
        fail[0]=false;hashed.updateDisplayListIfNeeded();check(!node.recording&&node.hasDisplayList()&&calls[0]==2,"hash renderer recovers on next call");
        hashed.updateDisplayListIfNeeded();check(calls[0]==2,"successful hash renderer cached");
    }
    public static void main(String[] args){String mode=args.length==0?"all":args[0];if(mode.equals("all")||mode.equals("viewgroup"))viewGroupTests();if(mode.equals("all")||mode.equals("visibility"))visibilityTests();if(mode.equals("all")||mode.equals("relative"))relativeTests();if(mode.equals("all")||mode.equals("suppressor"))suppressorTests();if(mode.equals("all")||mode.equals("hash"))hashTests();System.out.println("PASS: "+assertions+" production-derived blur capture canvas/rectangle/recording checks.");}
