        for(UItem row:cryptoRows)check(row.id!=Screen.ROW_PAY&&row.id!=Screen.ROW_CRYPTO_OPEN,"Unknown creation cannot create or open another invoice");
        cryptoScreen.client.cryptoRecovery=false;
        for(String state:new String[]{"creating","pending","review_required","paid","expired","activated"}) {
            cryptoScreen.client.crypto.order=new LunagramSubscriptionClient.CryptoOrder();
            LunagramSubscriptionClient.CryptoOrder order=cryptoScreen.client.crypto.order;
            order.status=state.equals("activated")?"paid":state;order.activated=state.equals("activated");
            if(!state.equals("pending"))order.checkoutUrl=null;
            cryptoRows.clear();cryptoScreen.fillItems(cryptoRows,new UniversalAdapter());
            boolean pay=false,open=false,activate=false,checkPayment=false;
            for(UItem row:cryptoRows) {
                if(row.id==Screen.ROW_PAY)pay=row.enabled;
                if(row.id==Screen.ROW_CRYPTO_OPEN)open=row.enabled;
                if(row.id==Screen.ROW_CRYPTO_CHECK)checkPayment=row.enabled;
                if(row.id==Screen.ROW_CRYPTO_ACTIVATE)activate=row.enabled;
            }
            check(pay==(state.equals("expired")||state.equals("activated")),"New invoice only after terminal previous order: "+state);
            check(open==state.equals("pending"),"Only pending order exposes invoice link: "+state);
            check(activate==state.equals("paid"),"Only unactivated paid order offers activation: "+state);
            check(checkPayment==(state.equals("creating")||state.equals("pending")||state.equals("review_required")),"Unresolved orders retain recovery action: "+state);
            check(cryptoScreen.cryptoCell.text.contains("0.50")&&cryptoScreen.cryptoCell.text.contains("Ultra"),"Outstanding legacy order preserves its own frozen total, not current purchase price");
        }
        cryptoScreen.activationDialog=new AlertDialog();cryptoScreen.activationField=null;cryptoScreen.activationIsCrypto=true;
        cryptoScreen.client.proposal=new LunagramSubscriptionClient.Quote();cryptoScreen.activationOperation=Screen.ACTIVATION_PREVIEW;
        cryptoScreen.updateActivationDialog();
        check(cryptoScreen.activationDialog.message.contains("CryptoConfirmDetails")&&!cryptoScreen.activationDialog.message.contains("350"),"Crypto preview shows exact dates without pretending a Stars charge or asking for key");
        cryptoScreen.activationOperation=Screen.ACTIVATION_CONFIRM;cryptoScreen.cryptoRequested=true;
        cryptoScreen.updateActivationDialog();
        check(!cryptoScreen.activationDialog.showing&&!cryptoScreen.cryptoRequested,"Confirmed crypto activation triggers durable state recovery");
        cryptoScreen.cryptoLaunchRequested=true;cryptoScreen.onPause();
        check(!cryptoScreen.cryptoLaunchRequested,"Leaving the fragment cancels automatic handoff intent");
        System.out.println("PASS: "+assertions+" actual-extracted subscription screen checks; modeled native cells/client, not rendered device UI.");
    }
