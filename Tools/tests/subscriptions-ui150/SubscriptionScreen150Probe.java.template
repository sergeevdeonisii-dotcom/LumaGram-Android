    static final class UItem {
        final String type;
        String text, value;
        int id;
        boolean checked, enabled=true;
        private UItem(String type, CharSequence text) { this.type=type; this.text=text==null?null:text.toString(); }
        static UItem asShadow(CharSequence text) { return new UItem("shadow",text); }
        static UItem asHeader(CharSequence text) { return new UItem("header",text); }
        static UItem asCustom(View view) { return new UItem("custom",null); }
        static UItem asButton(int id,CharSequence text) { UItem item=new UItem("button",text);item.id=id;return item; }
        static UItem asRadio2(int id,CharSequence text,CharSequence value) { UItem item=new UItem("radio",text);item.id=id;item.value=value.toString();return item; }
        UItem setEnabled(boolean enabled) { this.enabled=enabled;return this; }
        UItem setChecked(boolean checked) { this.checked=checked;return this; }
