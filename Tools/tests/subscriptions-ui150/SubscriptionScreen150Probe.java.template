/** Actual extracted screen methods with modeled native cells/client; not a device renderer. */
public final class SubscriptionScreen150Probe {
    private static int assertions;
    private static void check(boolean value, String message) { assertions++; if (!value) throw new AssertionError(message); }
    private static String getString(int id) { return Resources.name(id); }
    static final class LocaleController {
        static String formatString(int id, Object... args) { return getString(id) + Arrays.toString(args); }
