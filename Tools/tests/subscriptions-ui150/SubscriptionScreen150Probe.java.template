        check(screen.lastDialog!=null&&screen.lastDialog.showing,"duration dialog is shown");
        check(screen.lastDialog.title.equals(getString(R.string.LunagramSubscriptionPeriod)),"duration dialog has localized title");
        check(screen.lastDialog.content instanceof LinearLayout,"duration options use the actual custom content");
        LinearLayout options=(LinearLayout)screen.lastDialog.content;
        check(options.orientation==LinearLayout.VERTICAL,"durations keep catalog order in a vertical list");
        check(options.children.size()==LunagramSubscriptionCatalog.PERIODS.size(),"all four custom duration rows exist");
        for(int i=0;i<options.children.size();i++) {
            check(options.children.get(i) instanceof PeriodChoiceCell,"each duration has a modeled native radio row");
