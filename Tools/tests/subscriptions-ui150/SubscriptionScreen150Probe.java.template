                    "dialog gives every duration full container width and content height");
        }
        return options;
    }

    private static void testHeaderLoading() {
        for (int mask=0;mask<256;mask++) {
            Screen screen=new Screen();
            screen.statusLoading=(mask&1)!=0;screen.client.busy=(mask&2)!=0;
            screen.client.owner=(mask&4)!=0;screen.client.test=(mask&8)!=0;
            screen.isPaused=(mask&16)!=0;screen.isFinished=(mask&32)!=0;
            screen.client.fresh=(mask&64)!=0;
            if ((mask&128)!=0) screen.client=null;
            boolean expected=(mask&1)!=0&&(mask&2)!=0&&(mask&4)!=0&&(mask&8)==0
                    &&(mask&16)==0&&(mask&32)==0&&(mask&64)==0&&(mask&128)==0;
            check(screen.currentPlanText().equals(getString(R.string.LunagramSubscriptionCheckingStatus))==expected,
                    "header loading requires pending owner-bound live restore/status, not a generic busy operation: "+mask);
            check(screen.currentPlanId()==null,"loading UI never promotes a missing/cache-only receipt: "+mask);
        }
        Screen opening=new Screen();opening.client.authenticated=false;opening.client.fresh=false;
        opening.onResume();
        check(opening.client.restores==1&&opening.statusLoading&&opening.client.busy,"initial resume starts real local restore");
        check(opening.currentPlanText().equals(getString(R.string.LunagramSubscriptionCheckingStatus)),"restore starts with concise loading, not disconnected/error warning");
        LunagramSubscriptionClient.Subscription snapshot=new LunagramSubscriptionClient.Subscription();
        snapshot.current=new LunagramSubscriptionClient.Term("ultra",1,opening.client.now-1,opening.client.now+10000);
        opening.client.snapshot=snapshot;opening.client.authenticated=true;opening.client.busy=false;
        int updates=opening.listView.adapter.updates;
        opening.onSubscriptionChanged();
        check(opening.client.refreshes==1&&opening.statusRequested&&opening.statusLoading&&opening.client.busy,"restored history always chains to actual status request");
        check(opening.listView.adapter.updates==updates,"restore does not bind the historical warning between requests");
        opening.onSubscriptionChanged();
        check(opening.currentPlanText().equals(getString(R.string.LunagramSubscriptionCheckingStatus))&&opening.currentPlanId()==null,"pending refresh does not call cached paid term active");
        opening.client.busy=false;opening.client.failure=LunagramSubscriptionClient.Error.NETWORK;
        opening.onSubscriptionChanged();
        check(!opening.statusLoading&&opening.currentPlanText().equals(getString(R.string.LunagramSubscriptionLastConfirmed)),"actual failed refresh restores historical-data warning");
        check(opening.currentPlanId()==null,"failed refresh retains neutral non-authoritative status");
        opening.onItemClick(UItem.asButton(Screen.ROW_CHECK,"refresh"),null,0,0,0);
        check(opening.statusLoading&&opening.client.busy&&opening.currentPlanText().equals(getString(R.string.LunagramSubscriptionCheckingStatus)),"explicit retry uses the same concise pending state");
        opening.client.busy=false;opening.client.fresh=true;opening.client.failure=LunagramSubscriptionClient.Error.NONE;
        opening.onSubscriptionChanged();
        check(!opening.statusLoading&&opening.currentPlanText().equals(getString(R.string.LunagramSubscriptionUltraActive)),"only fresh authenticated success becomes active");
        check(opening.client.cryptoRefreshes==1&&opening.currentPlanText().equals(getString(R.string.LunagramSubscriptionUltraActive)),"later crypto metadata request does not flash header loading");
        opening.statusLoading=true;opening.onPause();
        check(!opening.statusLoading,"pause clears UI-only pending state");
        Screen noSession=new Screen();noSession.client.authenticated=false;noSession.client.fresh=false;
        noSession.onResume();noSession.client.busy=false;noSession.onSubscriptionChanged();
        check(!noSession.statusLoading&&noSession.client.refreshes==0,"restore without session ends loading without pretending a status request exists");
        check(noSession.currentPlanText().equals(getString(R.string.LunagramSubscriptionStatusUnknown)),"missing account/session retains truthful unknown status");
        Screen fresh=new Screen();fresh.client.snapshot=snapshot;fresh.onResume();
        check(fresh.statusLoading&&fresh.client.refreshes==1&&fresh.currentPlanText().equals(getString(R.string.LunagramSubscriptionUltraActive)),"fresh authenticated term stays visibly active during refresh");
        fresh.client.now=snapshot.current.expiresAtMs;
        check(fresh.currentPlanId()==null&&fresh.currentPlanText().equals(getString(R.string.LunagramSubscriptionFreeTier)),"expiry remains exclusive even while refresh is pending");
        int priorUpdates=fresh.listView.adapter.updates;fresh.onFragmentDestroy();fresh.onSubscriptionChanged();
        check(fresh.client==null&&fresh.isFinished&&fresh.listView.adapter.updates==priorUpdates,"late completion cannot update destroyed fragment");
    }
    public static void main(String[] args) {
        testHeaderLoading();
        Screen failureScreen=new Screen();
        failureScreen.client.failure=LunagramSubscriptionClient.Error.NETWORK;
        check(failureScreen.errorText().equals("LunagramSubscriptionNetworkError"),"network failures have connection guidance");
        failureScreen.client.failure=LunagramSubscriptionClient.Error.SERVER;
        check(failureScreen.errorText().equals("LunagramSubscriptionServerError"),"server rejection is distinct from network guidance");
        failureScreen.client.failure=LunagramSubscriptionClient.Error.STORAGE;
        check(failureScreen.errorText().equals("LunagramSubscriptionStorageError"),"storage failures have secure-session guidance");
        failureScreen.client.failure=LunagramSubscriptionClient.Error.PLAN_RETIRED;
        check(failureScreen.errorText().equals("LunagramSubscriptionPlanRetired"),"retired offer points to current Ultra, not generic network error");
        failureScreen.client.failure=LunagramSubscriptionClient.Error.CLIENT_UPDATE_REQUIRED;
        check(failureScreen.errorText().equals("LunagramSubscriptionClientUpdateRequired"),"outdated billing catalog asks for app update, not a more expensive tier");
        Bitmap logo=new Bitmap();
        check(!Screen.hasVisibleLogoFrame(null)&&!Screen.hasVisibleLogoFrame(logo),"no surface/transparent first frame cannot retire fallback");
        for(int[] row:logo.pixels)Arrays.fill(row,0xff000000);
        check(!Screen.hasVisibleLogoFrame(logo),"opaque black EGL frame is not visible logo");
        for(int[] row:logo.pixels)Arrays.fill(row,0xffffffff);
        check(!Screen.hasVisibleLogoFrame(logo),"white clear frame lacks branded disc");
        for(int y=5;y<19;y++)for(int x=5;x<12;x++)logo.pixels[y][x]=0xef7557fc;
        check(!Screen.hasVisibleLogoFrame(logo),"partly faded brand pixels cannot retire fallback");
        for(int y=5;y<19;y++)for(int x=5;x<12;x++)logo.pixels[y][x]=0xff7557fc;
        check(Screen.hasVisibleLogoFrame(logo),"opaque branded disc plus white tile/plane can retire fallback");
        Screen reduced=new Screen();reduced.motionAllowed=false;
        reduced.updateLogoState();
        check(!reduced.subscriptionLogo.paused,"reduced motion must still render through initially invisible frame");
        for(int i=0;i<12;i++)reduced.verifyLogoFrame();
        check(!reduced.logoReady&&reduced.logoFallback.visibility==View.VISIBLE&&!reduced.subscriptionLogo.paused,
                "transparent submitted frames retain fallback and keep first-frame work running");
        reduced.subscriptionLogo.nextFrame=logo;
        for(int i=0;i<4;i++)reduced.verifyLogoFrame();
        check(reduced.logoReady&&reduced.logoFallback.visibility==View.INVISIBLE&&reduced.subscriptionLogo.paused,
                "only verified visible frame replaces fallback and stops reduced-motion renderer");
        check(reduced.subscriptionLogo.readbacks==4,"sample only every fourth frame, not continuous GPU readback");
        Screen blank=new Screen();
        for(int i=0;i<32;i++)blank.verifyLogoFrame();
        check(blank.logoFailed&&!blank.logoReady&&blank.subscriptionLogo.paused&&blank.logoFallback.visibility==View.VISIBLE,
                "persistent blank rendering fails safely to current-logo fallback");
        check(blank.subscriptionLogo.readbacks==8,"blank surface has bounded eight readbacks");
        Screen hiddenLogo=new Screen();hiddenLogo.logoReady=true;hiddenLogo.subscriptionLogo.visible=false;hiddenLogo.updateLogoState();
        check(hiddenLogo.subscriptionLogo.paused,"offscreen logo does not render");
        hiddenLogo.subscriptionLogo.visible=true;hiddenLogo.isPaused=true;hiddenLogo.updateLogoState();
        check(hiddenLogo.subscriptionLogo.paused,"paused fragment does not render");
        for (Plan plan:LunagramSubscriptionCatalog.PLANS) for (Period period:Period.values()) {
            Screen screen=new Screen();screen.selectedPeriod=period;
            ArrayList<UItem> items=new ArrayList<>();screen.fillItems(items,new UniversalAdapter());
            int planSelectors=0,periodSelectors=0,featureRows=0;
