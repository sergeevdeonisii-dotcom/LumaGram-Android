    }
    static class Activity {
        Feed feed=new Feed();boolean visible=true;long owner=100;Config config=new Config();int opens,pickers,failures;
        Config getUserConfig(){return config;}void openPost(MessageObject p){opens++;}void chooseReaction(MessageObject p){pickers++;}void failedReaction(){failures++;}
        /* ACTUAL_SEND */
        final Delegate delegate=new Delegate(){
            /* ACTUAL_GATE */
            /* ACTUAL_REPLY_GATE */
            /* ACTUAL_REACTION */
        };
        final Delegate cellDelegate=delegate;
        final class BodyCell extends NativeCell {
            MessageObject bodyTouchPost;float bodyTouchX,bodyTouchY;
            /* ACTUAL_BODY_CANCEL */
            /* ACTUAL_BODY_TOUCH */
            /* ACTUAL_BODY_LONG */
            /* ACTUAL_BODY_DETACH */
        }
    }
    static class MotionEvent {
        static final int ACTION_DOWN=0,ACTION_UP=1,ACTION_MOVE=2,ACTION_CANCEL=3;
        final int action;final float x,y;int pointers=1;MotionEvent(int a,float x,float y){action=a;this.x=x;this.y=y;}
        int getAction(){return action;}int getActionMasked(){return action;}int getPointerCount(){return pointers;}float getX(){return x;}float getY(){return y;}
        static MotionEvent obtain(long down,long now,int action,float x,float y,int meta){return new MotionEvent(action,x,y);}void recycle(){}
    }
    interface IMessageCell {}
    static class View {int paddingTop;int getPaddingTop(){return paddingTop;}}
    static class ChatActionCell extends View implements IMessageCell {float sideMenuWidth;}
    static class ViewConfiguration {static int getLongPressTimeout(){return 500;}static int getTapTimeout(){return 100;}static ViewConfiguration get(Object context){return new ViewConfiguration();}int getScaledTouchSlop(){return 6;}}
    static class HapticFeedbackConstants {static final int LONG_PRESS=0;}
    static class AndroidUtilities {
        static final ArrayList<Runnable> tasks=new ArrayList<>();
        static void cancelRunOnUIThread(Runnable r){tasks.remove(r);}static void runOnUIThread(Runnable r,int delay){tasks.add(r);}
        static void runPending(){ArrayList<Runnable> pending=new ArrayList<>(tasks);tasks.clear();for(Runnable r:pending)r.run();}
    }
    static class Bounce {boolean pressed;void setPressed(boolean p){pressed=p;}}
    static class NativeCell extends ChatMessageCell {
        boolean nativeHandled,attached=true;int nativeTouches;
        private boolean checkingForLongPress;private int pressCount;
        private CheckForTap pendingCheckForTap;private CheckForLongPress pendingCheckForLongPress;
        /* ACTUAL_BASE_TAP */
        /* ACTUAL_BASE_LONG */
        /* ACTUAL_BASE_START */
        /* ACTUAL_BASE_CANCEL */
        Object getContext(){return this;}Object getParent(){return attached?this:null;}
        void postDelayed(Runnable task,int delay){AndroidUtilities.runOnUIThread(task,delay);}void removeCallbacks(Runnable task){AndroidUtilities.cancelRunOnUIThread(task);}
        void performHapticFeedback(int type){}
        public boolean onTouchEvent(MotionEvent event){nativeTouches++;return nativeHandled;}
        protected boolean onLongPress(){return false;}protected void onDetachedFromWindow(){attached=false;}
        int getBackgroundDrawableLeft(){return 20;}int getBackgroundDrawableRight(){return 280;}
