    public static void main(String[] args) {
        for(boolean visible:new boolean[]{true,false}) {
            Nav nav=new Nav();nav.feedTabVisible=visible;
            check(nav.getFragmentsCount()==(visible?5:4),"page count reflects hidden feed");
            int[] expected=visible?new int[]{0,1,2,3,3,4}:new int[]{0,-1,1,2,2,3};
            for(int index=0;index<6;index++)check(nav.indexToPosition(index)==expected[index],"stable tab identity after removal");
            for(int logical=0;logical<5;logical++) {
                if(!visible&&logical==1) { check(nav.logicalToPosition(logical)==-1,"feed cannot be selected while hidden");continue; }
                int position=nav.logicalToPosition(logical);
                check(position>=0&&position<nav.getFragmentsCount(),"bounded page index");
                check(nav.positionToLogical(position)==logical,"round trip page identity");
                nav.viewPager.position=position;nav.dialogsTabsVisible=false;nav.updateTabsVisibility(false);
                check(nav.animatorTabsVisible.visible==(logical!=0),"Chats search suppression never leaks to other tabs");
            }
        }
        for(int cycle=0;cycle<100;cycle++)for(int logical=0;logical<5;logical++) {
            Nav nav=new Nav();nav.viewPager.position=logical;
            for(int i=0;i<5;i++)nav.fragmentsArr.values.put(i,new Object());
            Object chats=nav.fragmentsArr.values.get(0);LunagramExperienceSettings.visible=false;nav.syncFeedVisibility();
            check(nav.viewPager.position==(logical==1?0:logical==0?0:logical-1),"hide preserves current peer tab or returns Feed toChats");
            check(nav.drops==4&&nav.fragmentsArr.size()==1&&nav.fragmentsArr.values.get(0)==chats,"old shifted fragments disposed; Chats preserved");
            check(!nav.tabsView.feedShown&&!nav.feedTabVisible&&nav.viewPager.rebuilds==1,"one UI rebuild when hiding");
            nav.syncFeedVisibility();check(nav.viewPager.rebuilds==1,"unchanged preference does not rebuild");
            LunagramExperienceSettings.visible=true;nav.syncFeedVisibility();
            check(nav.viewPager.position==(logical==1?0:logical),"reenable restores position mapping");
            check(nav.tabsView.feedShown&&nav.getFragmentsCount()==5,"settings can reenable Feed");
        }
        for(boolean tablet:new boolean[]{false,true})for(int width:new int[]{160,240,320,360,680,1000,1400}) {
            AndroidUtilities.tablet=tablet;
            LunagramFeedActivity feed=new LunagramFeedActivity();feed.list.width=width+16;feed.list.height=700;
            LunagramFeedActivity.PostView post=feed.new PostView();
            for(int bind=0;bind<100;bind++) {
                MessageOwner owner=new MessageOwner();owner.id=bind;
                MessageObject original=new MessageObject(0,owner,true,true);post.bind(original);
                post.message.onMeasure(width,0);
                check(post.message.current!=original&&post.message.current.messageOwner==original.messageOwner,"presentation clone, no mutation of source metadata");
                check(!original.preview&&original.parentWidth==0&&original.layoutParentWidth==0&&original.layoutWidth==(tablet?720:1000),"original message untouched");
                check(!post.message.current.preview&&post.message.current.layoutParentWidth==width,"normal drawing with actual available cell width");
                check(post.message.current.layoutWidth==width,"same-width recycled binds never retain screen-width layout");
                int drawn=post.message.contentDraws;post.message.drawContent(false);
                check(post.message.contentDraws==drawn+1,"native normal draw entry paints content on EVERY bind");
                check(!post.message.current.checkLayout(),"tablet/phone checks never regenerate against global screen width");
                check(post.message.getHostTabletSide()==Math.min(720,width),"opt-in split/tablet width constrains native branches");
                check(post.message.photoConstraint()==(int)(Math.min(720,width)*.7f),"actual native photo branch bounded by feed host");
                check(post.message.linkConstraint()==Math.min(720,width)-80,"actual native link branch bounded by feed host");
                check(post.message.reactionConstraint()==Math.min(720,width)-80,"actual native reaction branch bounded by feed host");
                check(post.message.getGroupPhotosWidth()==width,"measured feed pane is never subtracted twice on tablet");
            }
            for(int resized:new int[]{width+80,width,width+160,width}) {
                post.message.onMeasure(resized,0);
                check(post.message.current.layoutWidth==resized&&post.message.current.layoutParentWidth==resized,"resize regenerates text/media constraint");
                check(!post.message.current.checkLayout(),"resized layout remains bound to host rather than tablet screen");
                check(post.message.photoConstraint()==(int)(Math.min(720,resized)*.7f),"resize updates native media constraint");
            }
