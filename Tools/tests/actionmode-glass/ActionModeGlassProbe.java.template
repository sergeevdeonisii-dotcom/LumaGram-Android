        ActionBarMenu menu,actionMode;View backButtonImageView;Drawable glassDrawableMenu=new Drawable();Factor animatorMenuItemsWidth=new Factor(),animatorHasMenuItems=new Factor();
        int dp(float v){return (int)Math.ceil(v*density);}int getWidth(){return width;}int getHeight(){return height;}int getCurrentActionBarHeight(){return actionHeight;}float getActionModeFactor(){return actionModeVisible?1:0;}
        @@WIDTH_METHOD@@
        void drawMenu(Canvas canvas){@@DRAW_PREFIX@@ @@DRAW_BRANCH@@}
    }
    static class ActionBarMenu{int itemsWidth;float x=Float.NaN,y=Float.NaN;int getItemsWidth(){return itemsWidth;}float getExclusiveItemCenterXInParent(){return x;}float getExclusiveItemCenterYInParent(){return y;}}
    static class Factor{float value;float getToFactor(){return value;}float getFactor(){return value;}float getFloatValue(){return value;}void animateTo(float v){value=v;}void forceFactor(float v){value=v;}void setValue(boolean v,boolean animated){value=v?1:0;}}
