import java.lang.reflect.Field;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashSet;
import java.util.List;
import java.util.Set;
import java.util.TreeSet;
import java.util.TreeMap;

/** Real production draw() bodies on a recording Canvas; not Android pixels/FPS. */
public final class StatusDrawableBoundsProbe {
    static int assertions, frames;
    static final TreeMap<Float,Float> sendingOverhangDp=new TreeMap<>();
    static void check(boolean value, String label) {
        assertions++;
        if (!value) throw new AssertionError(label);
    }
    static void close(float expected, float actual, String label) {
        check(Math.abs(expected - actual) < 0.001f, label + ": " + expected + " != " + actual);
    }
    @interface NonNull { }
    @interface Nullable { }
    static final class ColorFilter { }
    static final class PixelFormat { static final int TRANSPARENT = -3; }
    static final class Rect {
        int left, top, right, bottom;
        float exactCenterY() { return (top + bottom) * 0.5f; }
    }
    static final class RectF {
        float left, top, right, bottom;
        void set(float l, float t, float r, float b) { left=l;top=t;right=r;bottom=b; }
    }
    static abstract class Drawable {
        final Rect bounds = new Rect();
        int invalidations;
        Rect getBounds() { return bounds; }
        void setBounds(int l,int t,int r,int b) { bounds.left=l;bounds.top=t;bounds.right=r;bounds.bottom=b; }
        void invalidateSelf() { invalidations++; }
        abstract void draw(Canvas c);
        abstract void setAlpha(int alpha);
        abstract void setColorFilter(ColorFilter cf);
        abstract int getOpacity();
        abstract int getIntrinsicWidth();
        abstract int getIntrinsicHeight();
    }
    static final class Paint {
        static final int ANTI_ALIAS_FLAG = 1;
        enum Style { FILL, STROKE }
        enum Cap { BUTT, ROUND }
        int alpha=255,color;
        float strokeWidth=1;
        Style style=Style.FILL;
        Cap cap=Cap.BUTT;
        Paint(int flags) { }
        void setStyle(Style v) { style=v; }
        void setStrokeCap(Cap v) { cap=v; }
        void setStrokeWidth(float v) { strokeWidth=v; }
        float getStrokeWidth() { return strokeWidth; }
        void setColor(int v) { color=v; }
        void setAlpha(int v) { alpha=v; }
        void setColorFilter(ColorFilter ignored) { }
    }
    static final class Draw {
        final String kind;
        final float[] coords;
        final int alpha,color;
        final float strokeWidth;
        final Paint.Style style;
        final Paint.Cap cap;
        Draw(String k,Paint p,float... c) {
            kind=k;coords=c;alpha=p.alpha;color=p.color;strokeWidth=p.strokeWidth;style=p.style;cap=p.cap;
        }
    }
    static final class Canvas {
        float tx,ty;
        final List<float[]> stack=new ArrayList<>();
        final List<Draw> draws=new ArrayList<>();
        int finalSharedStatusAlpha,finalSharedRecordAlpha;
        int save() { stack.add(new float[]{tx,ty});return stack.size(); }
        void restore() {
            if (stack.isEmpty()) throw new AssertionError("Canvas restore underflow");
            float[] saved=stack.remove(stack.size()-1);tx=saved[0];ty=saved[1];
        }
        void restoreToCount(int count) {
            if (count<1 || count>stack.size()+1) throw new AssertionError("Invalid Canvas restore count");
            while(stack.size()>=count) restore();
        }
        void translate(float x,float y) { tx+=x;ty+=y; }
        void drawLine(float x1,float y1,float x2,float y2,Paint p) { draws.add(new Draw("line",p,x1+tx,y1+ty,x2+tx,y2+ty)); }
        void drawCircle(float x,float y,float radius,Paint p) { draws.add(new Draw("circle",p,x+tx,y+ty,radius)); }
        void drawOval(RectF r,Paint p) { draws.add(new Draw("oval",p,r.left+tx,r.top+ty,r.right+tx,r.bottom+ty)); }
        void drawArc(RectF r,float start,float sweep,boolean center,Paint p) {
            draws.add(new Draw("arc",p,r.left+tx,r.top+ty,r.right+tx,r.bottom+ty,start,sweep,center?1:0));
        }
    }
    static final class AndroidUtilities {
        static float density=1;
        static final RectF rectTmp=new RectF();
        static int dp(float value) { return (int)Math.ceil(value*density); }
        static float dpf2(float value) { return value*density; }
        static void runOnUIThread(Runnable ignored,int delay) { }
    }
    static final class Theme {
        interface ResourcesProvider { }
        static final Paint chat_statusRecordPaint=new Paint(1),chat_statusPaint=new Paint(1);
        static final int key_chats_actionMessage=1,key_chat_status=2,key_windowBackgroundWhite=3,key_actionBarDefault=4;
        static int getColor(int key) { return 0xff000000|key; }
        static int getColor(int key,ResourcesProvider ignored) { return getColor(key); }
    }
    static final class UserConfig { static int selectedAccount=0; }
    static final class NotificationCenter {
        static final NotificationCenter instance=new NotificationCenter();
        static NotificationCenter getInstance(int account) { return instance; }
        boolean isAnimationInProgress() { return false; }
    }
    static final class Choreographer60FpsContent {
        static final Choreographer60FpsContent instance=new Choreographer60FpsContent();
        static Choreographer60FpsContent getInstance() { return instance; }
        void postInvalidateDrawable30fps(Drawable d) { d.invalidateSelf(); }
    }
    static final class DecelerateInterpolator {
        float getInterpolation(float p) { return 1-(1-p)*(1-p); }
    }
    // Geometry invariance is independent of the platform easing implementation.
    static final class CubicBezierInterpolator {
        static final CubicBezierInterpolator EASE_IN=new CubicBezierInterpolator();
        static final CubicBezierInterpolator EASE_OUT=new CubicBezierInterpolator();
        static final CubicBezierInterpolator EASE_OUT_QUINT=new CubicBezierInterpolator();
        float getInterpolation(float p) { return p; }
    }

    // __PRODUCTION_CLASSES__

    static StatusDrawable create(String type,boolean privatePaint) {
        switch(type) {
            case "TypingDotsDrawable": return new TypingDotsDrawable(privatePaint);
            case "RecordStatusDrawable": return new RecordStatusDrawable(privatePaint);
            case "SendingFileDrawable": return new SendingFileDrawable(privatePaint);
            case "PlayingGameDrawable": return new PlayingGameDrawable(false,null);
            case "PlayingGameDialogDrawable": return new PlayingGameDrawable(true,null);
            case "RoundStatusDrawable": return new RoundStatusDrawable(privatePaint);
            case "RoundStatusHeaderDrawable": return new RoundStatusDrawable(privatePaint,true);
            case "ChoosingStickerStatusDrawable": return new ChoosingStickerStatusDrawable(true);
            default: throw new AssertionError(type);
        }
    }
    static void phase(StatusDrawable d,float p,boolean reverse) throws Exception {
        try { Field f=d.getClass().getDeclaredField("progress");f.setAccessible(true);f.setFloat(d,p); }
        catch(NoSuchFieldException ignored) { }
        if (d instanceof TypingDotsDrawable) {
            Field f=d.getClass().getDeclaredField("scales");f.setAccessible(true);
            float[] s=(float[])f.get(d);s[0]=1.33f+p;s[1]=1.33f+p*0.5f;s[2]=2.33f-p;
        }
        if (d instanceof ChoosingStickerStatusDrawable) ((ChoosingStickerStatusDrawable)d).increment=!reverse;
    }
    static Canvas render(String type,boolean privatePaint,boolean chat,float p,boolean reverse,int dx,int dy) throws Exception {
        Theme.chat_statusPaint.setAlpha(173);
        Theme.chat_statusPaint.setColor(0xff8877cc);
        Theme.chat_statusRecordPaint.setAlpha(173);
        Theme.chat_statusRecordPaint.setColor(0xff8877cc);
        Theme.chat_statusRecordPaint.setStrokeWidth(AndroidUtilities.dp(2));
        Theme.chat_statusRecordPaint.setStyle(Paint.Style.STROKE);
        Theme.chat_statusRecordPaint.setStrokeCap(Paint.Cap.ROUND);
        StatusDrawable d=create(type,privatePaint);
        d.setIsChat(chat);
        d.setColor(0xff8877cc);
        d.setAlpha(173); // Honored by RecordStatus; other status classes intentionally ignore alpha.
        phase(d,p,reverse);
        d.setBounds(dx,dy,dx+d.getIntrinsicWidth(),dy+d.getIntrinsicHeight());
        Canvas c=new Canvas();
        c.translate(AndroidUtilities.dpf2(8.5f),AndroidUtilities.dpf2(7.25f));
        c.save();
        float initialX=c.tx,initialY=c.ty;
        d.draw(c);
        frames++;
        close(initialX,c.tx,type+" canvas x restored");
        close(initialY,c.ty,type+" canvas y restored");
        check(c.stack.size()==1,type+" caller save stack preserved");
        check(d.getBounds().left==dx && d.getBounds().top==dy,type+" bounds unchanged");
        check(!c.draws.isEmpty(),type+" renders shapes");
        for (Draw draw:c.draws) {
            check(draw.alpha>=0 && draw.alpha<=255,type+" valid alpha");
            for (float coordinate:draw.coords) check(Float.isFinite(coordinate),type+" finite geometry");
        }
        // Shared Paint mutation is intentional upstream; only compare equivalent
        // zero/offset frames, never require restoration to its initial alpha.
        c.finalSharedStatusAlpha=Theme.chat_statusPaint.alpha;
        c.finalSharedRecordAlpha=Theme.chat_statusRecordPaint.alpha;
        if(type.equals("SendingFileDrawable") && dx==0 && dy==0) {
            float right=0;
            for(Draw draw:c.draws) if(draw.alpha>0) {
                right=Math.max(right,Math.max(draw.coords[0],draw.coords[2])+draw.strokeWidth*0.5f);
            }
            float overhang=(right-initialX-d.getIntrinsicWidth())/AndroidUtilities.density;
            float previous=sendingOverhangDp.getOrDefault(AndroidUtilities.density,0f);
            sendingOverhangDp.put(AndroidUtilities.density,Math.max(previous,overhang));
        }
        return c;
    }
    static void translated(Canvas baseline,Canvas shifted,int dx,int dy,String label) {
        check(baseline.draws.size()==shifted.draws.size(),label+" shape count unchanged");
        check(baseline.finalSharedStatusAlpha==shifted.finalSharedStatusAlpha &&
                baseline.finalSharedRecordAlpha==shifted.finalSharedRecordAlpha,label+" shared Paint alpha semantics unchanged");
        for(int i=0;i<baseline.draws.size();i++) {
            Draw a=baseline.draws.get(i),b=shifted.draws.get(i);
            check(a.kind.equals(b.kind),label+" shape kind unchanged");
            check(a.alpha==b.alpha && a.color==b.color && a.style==b.style && a.cap==b.cap,label+" paint appearance unchanged");
            close(a.strokeWidth,b.strokeWidth,label+" stroke unchanged");
            check(a.coords.length==b.coords.length,label+" coordinate count unchanged");
            int positioned=a.kind.equals("circle")?2:4;
            for(int j=0;j<a.coords.length;j++) {
                float delta=j<positioned?(j%2==0?dx:dy):0;
                close(a.coords[j]+delta,b.coords[j],label+" shape "+i+" coordinate "+j);
            }
        }
    }
    static void originContract(String type,Canvas frame,boolean chat,float progress) {
        // Absolute zero-bounds landmarks preserve the old dialog/compound-drawable geometry.
        float x=AndroidUtilities.dpf2(8.5f),y=AndroidUtilities.dpf2(7.25f);
        Draw first=frame.draws.get(0);
        if(type.equals("SendingFileDrawable")) {
            check(frame.draws.size()==6,"sending retains all six line segments");
            close(x+AndroidUtilities.dp(5)*progress,first.coords[0],"sending legacy origin x");
            close(y+AndroidUtilities.dp(chat?3:4),first.coords[1],"sending legacy origin y");
        } else if(type.startsWith("PlayingGame")) {
            check(frame.draws.size()==5,"game retains dots, arc and eye");
            close(x+AndroidUtilities.dp(9.2f)-AndroidUtilities.dp(5)*progress,first.coords[0],"game legacy dot x");
            Draw arc=frame.draws.get(3);
            close(x,arc.coords[0],"game legacy arc left");
            Draw eye=frame.draws.get(4);
            close(x+AndroidUtilities.dp(4),eye.coords[0],"game legacy eye x");
        }
    }
    public static void main(String[] args) throws Exception {
        Set<String> expectedFailures=new TreeSet<>();
        if(args.length==1 && args[0].startsWith("--expect-failures=")) {
            expectedFailures.addAll(Arrays.asList(args[0].substring("--expect-failures=".length()).split(",")));
        } else if(args.length!=0) throw new AssertionError("Unexpected arguments");
        String[] types={"TypingDotsDrawable","RecordStatusDrawable","SendingFileDrawable","PlayingGameDrawable",
                "PlayingGameDialogDrawable","RoundStatusDrawable","RoundStatusHeaderDrawable","ChoosingStickerStatusDrawable"};
        Set<String> failures=new TreeSet<>();
        for(String type:types) {
            for(float density:new float[]{1f,1.5f,2.75f,4f}) {
                AndroidUtilities.density=density;
                for(boolean privatePaint:new boolean[]{false,true}) {
                    // These production callers always own their Paint.
                    if(!privatePaint && (type.startsWith("PlayingGame") || type.equals("ChoosingStickerStatusDrawable"))) continue;
                for(boolean chat:new boolean[]{false,true}) {
                    float[] phases=type.equals("ChoosingStickerStatusDrawable")?
                            new float[]{0f,0.2f,0.49f,0.5f,0.8f,0.99f,1.5f,1.99f}:new float[]{0f,0.2f,0.49f,0.5f,0.8f,0.99f};
                    for(float p:phases) {
                        for(boolean reverse:new boolean[]{false,true}) {
                            Canvas base=render(type,privatePaint,chat,p,reverse,0,0);
                            originContract(type,base,chat,p);
                            for(int[] offset:new int[][]{{37,19},{-13,-7}}) {
                                Canvas shifted=render(type,privatePaint,chat,p,reverse,offset[0],offset[1]);
                                try { translated(base,shifted,offset[0],offset[1],type); }
                                catch(AssertionError failure) {
                                    String group=type.startsWith("PlayingGame")?"PlayingGameDrawable":type;
                                    if(failures.add(group)) System.out.println("BOUNDS FAILURE: "+failure.getMessage());
                                }
                            }
                        }
                    }
                }
                }
            }
        }
        check(failures.equals(expectedFailures),"Expected failures "+expectedFailures+", actual "+failures);
        if(expectedFailures.isEmpty()) System.out.println("PASS: "+assertions+" assertions, "+frames+" frames; all six real status drawables respect bounds and preserve Canvas/appearance.");
        else System.out.println("PASS: negative control detected exactly "+failures+"; "+assertions+" assertions, "+frames+" frames.");
        if(expectedFailures.isEmpty()) System.out.println("SendingFile visible stroke overhang in dp by density (spacing evidence, not a font measurement): "+sendingOverhangDp);
    }
}
