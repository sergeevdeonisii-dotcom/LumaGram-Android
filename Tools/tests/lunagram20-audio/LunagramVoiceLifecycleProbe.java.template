        p.recordQueue.drain();check(initializing.stops==1&&initializing.releases==1&&p.internalStops==1,"Canceled startup closes once after barrier");
        p=new LunagramVoiceLifecycleProbe();Recorder newer=new Recorder();p.audioRecorder=newer;p.recordStartRunnable=()->{};p.stopRecording(0,false,0,false,0);
        p.lunagramRecordingGeneration++;p.fileEncodingQueue.drain();p.recordQueue.drain();check(newer.stops==0&&newer.releases==0,"Stale canceled startup cannot stop newer generation");
        p=new LunagramVoiceLifecycleProbe();p.recordStartRunnable=()->{};p.stopRecording(0,false,0,false,0);p.fileEncodingQueue.drain();p.recordQueue.drain();check(!p.manualRecording&&p.focusReleases>0&&p.internalStops==0,"Cancel before microphone opens releases focus without fake recording");
