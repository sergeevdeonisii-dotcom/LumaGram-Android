import java.io.File;
import java.util.ArrayDeque;
/** Queue contract around the extracted production stop method; no microphone or Android runtime. */
public final class LunagramVoiceLifecycleProbe {
    @@STOP@@
    int lunagramRecordingGeneration;
    Runnable recordStartRunnable;
    final Queue recordQueue=new Queue(),fileEncodingQueue=new Queue();
    Recorder audioRecorder;
    Object recordingAudio=new Object();File recordingAudioFile;
    int sendAfterDone,sendAfterDoneScheduleDate,recordingCurrentAccount,recordingGuid;
    boolean sendAfterDoneNotify,sendAfterDoneOnce,manualRecording=true,raiseToEarRecord=true,ignoreOnPause=true;
