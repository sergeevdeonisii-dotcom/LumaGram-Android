    public static void main(String[]args){
        LunagramVoiceLifecycleProbe p=new LunagramVoiceLifecycleProbe();Recorder initializing=new Recorder();p.audioRecorder=initializing;p.recordStartRunnable=()->{};
        p.fileEncodingQueue.postRunnable(()->check(initializing.stops==0&&initializing.releases==0,"Initializer owns live recorder"));
        p.stopRecording(0,false,0,false,0);
