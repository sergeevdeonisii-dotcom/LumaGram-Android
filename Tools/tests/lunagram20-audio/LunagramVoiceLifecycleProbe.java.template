    static class Queue {
        final ArrayDeque<Runnable> tasks=new ArrayDeque<>();
        void postRunnable(Runnable task){tasks.add(task);}void cancelRunnable(Runnable task){tasks.remove(task);}
        void next(){if(tasks.isEmpty())throw new AssertionError("Missing queued work");tasks.removeFirst().run();}
        void drain(){for(int i=0;!tasks.isEmpty()&&i<30;i++)next();if(!tasks.isEmpty())throw new AssertionError("Queue did not settle");}
    }
    static class Recorder {int stops,releases;void stop(){stops++;}void release(){releases++;}}
    static class Feedback {void performHapticFeedback(int value,int flag){}}
    static class HapticFeedbackConstants {static final int KEYBOARD_TAP=1,FLAG_IGNORE_GLOBAL_SETTING=2;}
    static class FileLog {static void e(Exception error){}static void e(String error){}}
    static class BuildVars {static final boolean LOGS_ENABLED=false;}
    static class AndroidUtilities {static void runOnUIThread(Runnable task){task.run();}}
    static class NotificationCenter {static final int recordStopped=1;static NotificationCenter getInstance(int account){return new NotificationCenter();}void postNotificationName(Object...values){}}
