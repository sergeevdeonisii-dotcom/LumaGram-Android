import java.util.*;

/** Actual container and extracted transition/cell lifecycle bodies. Modeled Android, no pixel/FPS claim. */
public final class OutgoingLifecycleProbe {
    static int checks;
    static void check(boolean ok,String name){checks++;if(!ok)throw new AssertionError(name);}
    public static void main(String[]args){cellOwnership();containerLifecycle();textLifecycle();voiceLifecycle();System.out.println("PASS "+checks+" actual outgoing lifecycle/ownership assertions; no device render claim");}
    static MessageEnterTransitionContainer container(){NotificationCenter.instance.jobs.clear();return new MessageEnterTransitionContainer(new ViewGroup(new Context()),0);}
    static void cellOwnership(){
        ChatMessageCell c=new ChatMessageCell();Object old=new Object(),next=new Object();
        c.beginEnterTransition(old);check(c.ownsEnterTransition(old)&&c.enterTransitionInProgress,"cell begins with explicit owner");
        c.beginEnterTransition(next);c.finishEnterTransition(old);check(c.ownsEnterTransition(next)&&c.enterTransitionInProgress,"old transition cannot clear new cell owner");
        c.finishEnterTransition(next);check(!c.enterTransitionInProgress&&!c.ownsEnterTransition(next),"current owner clears own flag");
        c.beginEnterTransition(old);c.setEnterTransitionInProgress(false);check(!c.ownsEnterTransition(old)&&!c.enterTransitionInProgress,"legacy reset revokes old owner");
        int invalidations=c.invalidations;c.finishEnterTransition(old);check(c.invalidations==invalidations,"stale owner cleanup does not invalidate recycled cell");
    }
    static void containerLifecycle(){
        MessageEnterTransitionContainer c=container();DummyTransition first=new DummyTransition(c),second=new DummyTransition(c),third=new DummyTransition(c);
        first.selfCancelOnDraw=true;c.onDraw(new Canvas());check(first.draws==1&&second.draws==1&&third.draws==1,"self-removing transition cannot skip next draw");
        c.cancelAll();check(!c.isRunning()&&second.cancels==1&&third.cancels==1&&c.getVisibility()==View.GONE,"cancelAll handles removal during iteration");
        c.cancelAll();check(second.cancels==1&&third.cancels==1,"empty cancelAll idempotent");
        DummyTransition a=new DummyTransition(c);a.cancel();check(!NotificationCenter.instance.jobs.isEmpty(),"last transition schedules idle hide");
        DummyTransition b=new DummyTransition(c);NotificationCenter.instance.flush();check(c.isRunning()&&c.getVisibility()==View.VISIBLE,"new active transition survives stale idle hide");
        c.onDetachedFromWindow();check(!c.isRunning()&&b.cancels==1&&NotificationCenter.instance.jobs.isEmpty(),"container detach cancels all work and idle hides");
    }
    static void textLifecycle(){
        MessageEnterTransitionContainer c=container();ChatActivityEnterView input=new ChatActivityEnterView();ChatActivity chat=new ChatActivity();ChatMessageCell a=new ChatMessageCell(),b=new ChatMessageCell();
        TextMessageEnterTransition old=new TextMessageEnterTransition(c,a,input,chat),next=new TextMessageEnterTransition(c,b,input,chat);
        old.start();next.start();input.edit.setAlpha(.25f);chat.replyName.setAlpha(.3f);chat.replyObject.setAlpha(.4f);
        old.animator.value=.75f;old.tick(old.animator);check(input.edit.alpha==.25f,"older update cannot change newer composer alpha");
        int releases=AnimatedEmojiSpan.releases;old.finish();check(input.running&&input.edit.alpha==.25f&&chat.replyName.alpha==.3f&&chat.replyObject.alpha==.4f,"older completion cannot reset newer composer or reply UI");
        check(!a.enterTransitionInProgress&&b.enterTransitionInProgress&&c.isTextTransitionOwner(next),"old finish clears only its own cell");
        check(old.notificationsLocker.unlocks==1&&AnimatedEmojiSpan.releases==releases+1,"text cleanup releases owned resources once");
        old.cancel();old.finish();old.start();check(old.notificationsLocker.unlocks==1&&AnimatedEmojiSpan.releases==releases+1&&old.animator.starts==1,"text finished cancel and start are idempotent");
        next.animator.value=.7f;next.tick(next.animator);check(input.edit.alpha==.7f,"current text owner controls composer alpha");
        next.cancel();check(!input.running&&input.edit.alpha==1&&chat.replyName.alpha==1&&chat.replyObject.alpha==1&&!b.enterTransitionInProgress&&!c.isRunning(),"current text completion restores live UI");
        check(next.animator.cancels==1&&next.notificationsLocker.unlocks==1,"animator callback and explicit finish cannot double cleanup");
        c=container();ChatMessageCell reused=new ChatMessageCell();TextMessageEnterTransition stale=new TextMessageEnterTransition(c,reused,input,chat);reused.message=new MessageObject();TextMessageEnterTransition current=new TextMessageEnterTransition(c,reused,input,chat);
        stale.cancel();check(reused.ownsEnterTransition(current)&&reused.enterTransitionInProgress&&reused.params.lastDrawingBackgroundRect.sets==0,"recycled cell with new owner is untouched by stale finish");current.cancel();
        for(int invalid=0;invalid<8;invalid++){
            c=container();ChatMessageCell cell=new ChatMessageCell();chat=new ChatActivity();TextMessageEnterTransition t=new TextMessageEnterTransition(c,cell,new ChatActivityEnterView(),chat);t.start();check(t.isValid(),"fresh text transition valid");
            switch(invalid){case 0:cell.message=new MessageObject();break;case 1:cell.attached=false;break;case 2:t.session.current=false;break;case 3:chat.current=false;break;case 4:SharedConfig.animations=false;break;case 5:AndroidUtilities.scale=0;break;case 6:cell.beginEnterTransition(new Object());break;case 7:cell.message.stableId++;break;}
            check(!t.isValid(),"text stale owner/session/lifecycle/motion is invalid");t.animator.value=.5f;t.tick(t.animator);check(t.finished&&!c.isRunning()&&t.notificationsLocker.unlocks==1,"invalid text update cancels and cleans owned resources");
            t.onDraw(new Canvas());check(t.draws==0,"finished text never draws");SharedConfig.animations=true;AndroidUtilities.scale=1;
        }
        TextMessageEnterTransition partial=new TextMessageEnterTransition();partial.cancel();partial.cancel();check(partial.notificationsLocker.unlocks==0,"partially prepared constructor never unlocks unowned resources");
    }
    static void voiceLifecycle(){
        MessageEnterTransitionContainer c=container();ChatActivityEnterView.RecordCircle circle=new ChatActivityEnterView.RecordCircle();ChatMessageCell oldCell=new ChatMessageCell(),newCell=new ChatMessageCell();
        VoiceMessageEnterTransition old=new VoiceMessageEnterTransition(c,oldCell,circle),next=new VoiceMessageEnterTransition(c,newCell,circle);old.start();next.start();old.finish();
        check(circle.skipDraw&&circle.voiceEnterTransitionInProgress&&newCell.enterTransitionInProgress&&c.isVoiceTransitionOwner(next),"old voice finish cannot restore newer recording circle");
        next.cancel();check(!circle.skipDraw&&!circle.voiceEnterTransitionInProgress&&!newCell.enterTransitionInProgress&&!c.isRunning(),"current voice cleanup restores both record flags");
        int invalidations=circle.invalidations;next.cancel();next.finish();next.start();check(circle.invalidations==invalidations&&next.animator.starts==1&&next.animator.cancels==1,"voice cleanup idempotent");
        for(int invalid=0;invalid<6;invalid++){
            c=container();ChatMessageCell cell=new ChatMessageCell();VoiceMessageEnterTransition t=new VoiceMessageEnterTransition(c,cell,new ChatActivityEnterView.RecordCircle());t.start();check(t.isValid(),"fresh voice valid");
            switch(invalid){case 0:cell.message=new MessageObject();break;case 1:cell.attached=false;break;case 2:SharedConfig.animations=false;break;case 3:AndroidUtilities.scale=0;break;case 4:cell.beginEnterTransition(new Object());break;case 5:cell.message.stableId++;break;}
            check(!t.isValid(),"voice rebound/detach/motion/ownership invalid");t.tick(t.animator);check(t.finished&&!c.isRunning(),"invalid voice update cancels");t.onDraw(new Canvas());check(t.draws==0,"finished voice never draws");SharedConfig.animations=true;AndroidUtilities.scale=1;
        }
        c=container();TextMessageEnterTransition text=new TextMessageEnterTransition(c,new ChatMessageCell(),new ChatActivityEnterView(),new ChatActivity());VoiceMessageEnterTransition voice=new VoiceMessageEnterTransition(c,new ChatMessageCell(),new ChatActivityEnterView.RecordCircle());
        c.onDetachedFromWindow();check(text.finished&&voice.finished&&!c.isRunning()&&text.notificationsLocker.unlocks==1,"container detach cancels text and voice with cleanup");
        for(float radius:new float[]{-10,0,.001f,1,10}){c=container();VoiceMessageEnterTransition t=new VoiceMessageEnterTransition(c,new ChatMessageCell(),new ChatActivityEnterView.RecordCircle());t.radiusDraw(radius);check(radius>0?t.radiusDraws==1&&!t.finished:t.radiusDraws==0&&t.finished,"invalid voice radius cancels before division");t.cancel();}
    }

    @@CONTAINER@@
