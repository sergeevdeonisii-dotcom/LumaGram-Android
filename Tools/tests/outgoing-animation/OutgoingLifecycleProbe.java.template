        boolean active,finished;LunagramMediaAccess.Session session;ChatMessageCell messageView;MessageObject currentMessageObject;ChatActivity chatActivity;ChatActivityEnterView enterView;MessageEnterTransitionContainer container;ValueAnimator animator;final NotificationsLocker notificationsLocker=new NotificationsLocker();Object animatedEmojiStack=new Object();float progress;int draws,messageId;
        TextMessageEnterTransition(){}
        TextMessageEnterTransition(MessageEnterTransitionContainer c,ChatMessageCell cell,ChatActivityEnterView input,ChatActivity chat){container=c;messageView=cell;currentMessageObject=cell.getMessageObject();messageId=currentMessageObject.stableId;enterView=input;chatActivity=chat;session=new LunagramMediaAccess.Session();animator=new ValueAnimator();animator.ended=()->finish();active=true;c.addTransition(this);cell.beginEnterTransition(this);input.getEditField().setAlpha(0);input.setTextTransitionIsRunning(true);}
        @@TEXT_START@@
        @@TEXT_VALID@@
        @@TEXT_FINISH@@
        @@TEXT_CANCEL@@
        void tick(ValueAnimator valueAnimator){ChatActivityEnterView chatActivityEnterView=enterView;@@TEXT_UPDATE@@}
        public void onDraw(Canvas canvas){@@TEXT_DRAW_GUARD@@draws++;}
    }
    static class VoiceMessageEnterTransition implements MessageEnterTransitionContainer.Transition{
        boolean finished;ChatMessageCell messageView;MessageObject currentMessageObject;MessageEnterTransitionContainer container;ValueAnimator animator;ChatActivityEnterView.RecordCircle recordCircle;float progress;int draws,messageId,radiusDraws;
        VoiceMessageEnterTransition(MessageEnterTransitionContainer c,ChatMessageCell cell,ChatActivityEnterView.RecordCircle circle){container=c;messageView=cell;currentMessageObject=cell.getMessageObject();messageId=currentMessageObject.stableId;recordCircle=circle;animator=new ValueAnimator();animator.ended=()->finish();c.addTransition(this);cell.beginEnterTransition(this);if(circle!=null){circle.skipDraw=true;circle.voiceEnterTransitionInProgress=true;}}
        @@VOICE_START@@
        @@VOICE_VALID@@
        @@VOICE_FINISH@@
        @@VOICE_CANCEL@@
        void tick(ValueAnimator valueAnimator){@@VOICE_UPDATE@@}
        public void onDraw(Canvas canvas){@@VOICE_DRAW_GUARD@@draws++;}
        void radiusDraw(float toRadius){@@VOICE_RADIUS_GUARD@@radiusDraws++;check(Float.isFinite(1/toRadius),"voice division finite after radius guard");}
    }

    static class ChatMessageCell extends View {
        private Object enterTransitionOwner;boolean enterTransitionInProgress;MessageObject message=new MessageObject();final TransitionParams params=new TransitionParams();boolean attached=true;
        ChatMessageCell(){super(new Context());}
