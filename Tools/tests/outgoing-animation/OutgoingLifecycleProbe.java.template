    static class ChatActivity{boolean current=true;final View replyName=new View(new Context()),replyObject=new View(new Context());boolean canAnimateLunagramIncomingMessages(){return current;}View getReplyNameTextView(){return replyName;}View getReplyObjectTextView(){return replyObject;}}
    static class ChatActivityEnterView extends View{final View edit=new View(new Context());boolean running;int writes;ChatActivityEnterView(){super(new Context());}View getEditField(){return edit;}void setTextTransitionIsRunning(boolean value){running=value;writes++;}static class RecordCircle extends View{boolean skipDraw,voiceEnterTransitionInProgress;RecordCircle(){super(new Context());}}}
