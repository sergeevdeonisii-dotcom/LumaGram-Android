// FILE: android/animation/ValueAnimator.java
package android.animation;
import java.util.ArrayList;
public class ValueAnimator extends Animator {
    public interface AnimatorUpdateListener { void onAnimationUpdate(ValueAnimator animation); }
    public static final ArrayList<ValueAnimator> instances = new ArrayList<>();
    public static boolean enabled = true;
    public final ArrayList<AnimatorUpdateListener> updates = new ArrayList<>();
    public float from, to, value;
    public long duration;
    public boolean started, cancelled;
    public TimeInterpolator interpolator;
    public static ValueAnimator ofFloat(float... values) {
        ValueAnimator animator = new ValueAnimator(); animator.from=values[0]; animator.to=values[values.length-1];
        instances.add(animator); return animator;
    }
    public static boolean areAnimatorsEnabled() { return enabled; }
    public ValueAnimator setDuration(long value) { duration=value; return this; }
    public void setInterpolator(TimeInterpolator value) { interpolator=value; }
    public void addUpdateListener(AnimatorUpdateListener listener) { updates.add(listener); }
    public void removeAllUpdateListeners() { updates.clear(); }
    public Object getAnimatedValue() { return value; }
    public void start() { started=true; advance(0f); }
    public void cancel() { cancelled=true; end(); }
    public void advance(float fraction) {
        value=from+(to-from)*interpolator.getInterpolation(fraction);
        for (AnimatorUpdateListener listener : new ArrayList<>(updates)) listener.onAnimationUpdate(this);
        if (fraction==1f) end();
    }
}
