package org.telegram.messenger;
import java.util.ArrayList;
public class AndroidUtilities {
    public static float durationScale=1f;
    public static boolean failScale;
    public static long delay;
    public static final ArrayList<Runnable> pending=new ArrayList<>();
    public static float getAnimatorDurationScale() { if (failScale) throw new RuntimeException("controlled settings failure"); return durationScale; }
    public static void runOnUIThread(Runnable task,long duration) { delay=duration; pending.add(task); }
    public static void cancelRunOnUIThread(Runnable task) { pending.remove(task); }
}
